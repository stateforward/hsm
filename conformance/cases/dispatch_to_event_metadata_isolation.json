{
  "version": "hsm-conformance-v1",
  "name": "dispatch_to_event_metadata_isolation",
  "description": "Explicit multi-target dispatch_to recipients share ordinary mutable metadata while preserving the immutable event envelope.",
  "features": [
    "event_ownership",
    "guard"
  ],
  "model": {
    "name": "DispatchToEventMetadataIsolation",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "mutate",
            "guard": {
              "behavior": "owner_is_caller"
            },
            "target": "done",
            "effects": [
              {
                "behavior": "mutate_metadata"
              }
            ]
          },
          {
            "on": "mutate",
            "target": "leaked",
            "effects": [
              {
                "behavior": "effect_leaked"
              }
            ]
          }
        ]
      },
      {
        "name": "done"
      },
      {
        "name": "leaked"
      }
    ]
  },
  "instances": [
    {
      "id": "first"
    },
    {
      "id": "second"
    }
  ],
  "behaviors": {
    "owner_is_caller": [
      {
        "op": "trace",
        "value": "guard:owner-caller"
      },
      {
        "op": "event_metadata_equals",
        "name": "owner",
        "value": "caller"
      }
    ],
    "mutate_metadata": [
      {
        "op": "event_metadata_set",
        "name": "owner",
        "value": "changed"
      },
      {
        "op": "trace",
        "value": "effect:isolated"
      }
    ],
    "effect_leaked": [
      {
        "op": "trace",
        "value": "effect:leaked"
      }
    ]
  },
  "script": [
    {
      "op": "start",
      "instance": "first"
    },
    {
      "op": "start",
      "instance": "second"
    },
    {
      "op": "dispatch_to",
      "targets": [
        "first",
        "second"
      ],
      "event": {
        "name": "mutate",
        "metadata": {
          "owner": "caller"
        }
      }
    }
  ],
  "expect": {
    "states": {
      "first": "/DispatchToEventMetadataIsolation/done",
      "second": "/DispatchToEventMetadataIsolation/leaked"
    },
    "trace": [
      {
        "type": "dispatch",
        "event": "mutate",
        "target": [
          "first",
          "second"
        ]
      },
      {
        "type": "trace",
        "value": "guard:owner-caller"
      },
      {
        "type": "trace",
        "value": "effect:isolated"
      },
      {
        "type": "trace",
        "value": "guard:owner-caller"
      },
      {
        "type": "trace",
        "value": "effect:leaked"
      },
      {
        "type": "stable",
        "state": "targets:first,second"
      }
    ]
  }
}
