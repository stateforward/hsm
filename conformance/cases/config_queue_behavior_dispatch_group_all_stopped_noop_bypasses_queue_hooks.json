{
  "version": "hsm-conformance-v1",
  "name": "config_queue_behavior_dispatch_group_all_stopped_noop_bypasses_queue_hooks",
  "description": "Behavior-originated dispatch to an all-stopped group completes as a no-op before invoking stopped members' configured queue hooks.",
  "features": [
    "queue",
    "group",
    "lifecycle",
    "stop",
    "reentrancy"
  ],
  "model": {
    "name": "ConfigQueueBehaviorDispatchGroupAllStoppedNoopBypassesQueueHooks",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "go",
            "target": "done",
            "effects": [
              {
                "behavior": "dispatch_group"
              },
              {
                "behavior": "effect_after"
              }
            ]
          }
        ]
      },
      {
        "name": "done",
        "entry": [
          {
            "behavior": "entry_done"
          }
        ]
      }
    ]
  },
  "instances": [
    {
      "id": "producer"
    },
    {
      "id": "stopped_a",
      "config": {
        "queue": "push_error"
      }
    },
    {
      "id": "stopped_b",
      "config": {
        "queue": "push_error"
      }
    }
  ],
  "groups": [
    {
      "id": "stopped_workers",
      "members": [
        "stopped_a",
        "stopped_b"
      ]
    }
  ],
  "behaviors": {
    "dispatch_group": [
      {
        "op": "dispatch",
        "event": "audit",
        "group": "stopped_workers"
      }
    ],
    "effect_after": [
      {
        "op": "trace",
        "value": "effect:after"
      }
    ],
    "entry_done": [
      {
        "op": "trace",
        "value": "entry:done"
      }
    ]
  },
  "script": [
    {
      "op": "start",
      "instance": "producer"
    },
    {
      "op": "start",
      "instance": "stopped_a"
    },
    {
      "op": "start",
      "instance": "stopped_b"
    },
    {
      "op": "stop",
      "instance": "stopped_a"
    },
    {
      "op": "stop",
      "instance": "stopped_b"
    },
    {
      "op": "dispatch_to",
      "target": "producer",
      "event": "go"
    }
  ],
  "expect": {
    "states": {
      "producer": "/ConfigQueueBehaviorDispatchGroupAllStoppedNoopBypassesQueueHooks/done",
      "stopped_a": "",
      "stopped_b": ""
    },
    "trace": [
      {
        "type": "dispatch",
        "event": "go",
        "target": "producer"
      },
      {
        "type": "dispatch",
        "event": "audit",
        "target": "stopped_workers"
      },
      {
        "type": "trace",
        "value": "effect:after"
      },
      {
        "type": "trace",
        "value": "entry:done"
      },
      {
        "type": "stable",
        "state": "producer"
      }
    ]
  }
}
