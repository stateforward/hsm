{
  "version": "hsm-conformance-v1",
  "name": "config_queue_push_error_event",
  "description": "A custom queue Push failure rejects the dispatch completion and does not enqueue an ErrorEvent through the same failing queue hook.",
  "features": ["queue", "error"],
  "model": {
    "name": "ConfigQueuePushErrorEvent",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "hsm/error",
            "target": "failed",
            "effects": [
              {
                "behavior": "effect_error"
              }
            ]
          }
        ]
      },
      {
        "name": "failed"
      }
    ]
  },
  "instances": [
    {
      "id": "default",
      "config": {
        "queue": "push_error"
      }
    }
  ],
  "behaviors": {
    "effect_error": [
      {
        "op": "trace",
        "value": "effect:error"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "go"
    }
  ],
  "expect": {
    "state": "/ConfigQueuePushErrorEvent/idle",
    "error": {
      "code": "runtime_error",
      "message_contains": "push error"
    },
    "trace": [
      {
        "type": "dispatch",
        "event": "go"
      },
      {
        "type": "trace",
        "value": "queue:push-error:go"
      },
      {
        "type": "error",
        "code": "runtime_error"
      },
      {
        "type": "stable",
        "state": "/ConfigQueuePushErrorEvent/idle"
      }
    ]
  }
}
