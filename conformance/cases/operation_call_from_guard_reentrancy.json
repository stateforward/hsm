{
  "version": "hsm-conformance-v1",
  "name": "operation_call_from_guard_reentrancy",
  "description": "A guard can call an operation while evaluating a transition; the operation body runs before guard result and does not synchronously take the on_call transition.",
  "features": [
    "operation",
    "on_call",
    "guard",
    "reentrancy"
  ],
  "model": {
    "name": "OperationCallFromGuard",
    "initial": "idle",
    "operations": {
      "audit": {
        "behavior": "operation_audit"
      }
    },
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "go",
            "guard": {
              "behavior": "guard_calls_audit"
            },
            "target": "done",
            "effects": [
              {
                "behavior": "effect_done"
              }
            ]
          },
          {
            "trigger": {
              "kind": "on_call",
              "operation": "audit"
            },
            "target": "audit_handled",
            "effects": [
              {
                "behavior": "effect_audit_transition"
              }
            ]
          }
        ]
      },
      {
        "name": "done",
        "entry": [
          {
            "behavior": "entry_done"
          }
        ]
      },
      {
        "name": "audit_handled"
      }
    ]
  },
  "behaviors": {
    "operation_audit": [
      {
        "op": "trace",
        "value": "operation:audit"
      }
    ],
    "guard_calls_audit": [
      {
        "op": "trace",
        "value": "guard:before-call"
      },
      {
        "op": "call",
        "name": "audit"
      },
      {
        "op": "trace",
        "value": "guard:after-call"
      },
      {
        "op": "return_value",
        "value": true
      }
    ],
    "effect_done": [
      {
        "op": "trace",
        "value": "effect:done"
      }
    ],
    "effect_audit_transition": [
      {
        "op": "trace",
        "value": "effect:audit-transition"
      }
    ],
    "entry_done": [
      {
        "op": "trace",
        "value": "enter:done"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "go"
    }
  ],
  "expect": {
    "state": "/OperationCallFromGuard/done",
    "trace": [
      {
        "type": "dispatch",
        "event": "go"
      },
      {
        "type": "trace",
        "value": "guard:before-call"
      },
      {
        "type": "trace",
        "value": "operation:audit"
      },
      {
        "type": "trace",
        "value": "guard:after-call"
      },
      {
        "type": "trace",
        "value": "effect:done"
      },
      {
        "type": "trace",
        "value": "enter:done"
      },
      {
        "type": "stable",
        "state": "/OperationCallFromGuard/done"
      }
    ]
  }
}
