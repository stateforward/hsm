{
  "version": "hsm-conformance-v1",
  "name": "invalid_submodel_nested_missing_initial_target",
  "mode": "validation",
  "description": "Nested composite initial targets inside child models must resolve inside that composite.",
  "features": ["submachine", "nested", "validation"],
  "model": {
    "name": "InvalidSubmodelNestedMissingInitialTarget",
    "initial": "drive",
    "states": [
      {
        "name": "drive",
        "kind": "submachine",
        "machine": "ChildNestedMissingInitialTarget"
      }
    ]
  },
  "models": [
    {
      "name": "ChildNestedMissingInitialTarget",
      "initial": "parent",
      "states": [
        {
          "name": "parent",
          "initial": "missing",
          "states": [
            {
              "name": "a"
            }
          ]
        }
      ]
    }
  ],
  "expect": {
    "validation": [
      {
        "code": "missing_target"
      }
    ]
  }
}
