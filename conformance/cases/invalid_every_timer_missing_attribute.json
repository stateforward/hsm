{
  "version": "hsm-conformance-v1",
  "name": "invalid_every_timer_missing_attribute",
  "mode": "validation",
  "description": "An every timer trigger using an attribute source must reference a declared model attribute.",
  "features": ["timer", "every", "validation"],
  "model": {
    "name": "InvalidEveryTimerMissingAttribute",
    "initial": "waiting",
    "states": [
      {
        "name": "waiting",
        "transitions": [
          {
            "trigger": {
              "kind": "every",
              "attribute": "missing_interval"
            },
            "target": "done"
          }
        ]
      },
      {
        "name": "done"
      }
    ]
  },
  "expect": {
    "validation": [
      {
        "code": "missing_timer_attribute"
      }
    ]
  }
}
