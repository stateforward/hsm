{
  "version": "hsm-conformance-v1",
  "name": "behavior_snapshot_from_exit_point_effect",
  "description": "A behavior-side snapshot from an exit-point effect observes the submachine state before the parent boundary exits.",
  "features": [
    "submachine",
    "exit_point",
    "snapshot"
  ],
  "model": {
    "name": "BehaviorSnapshotFromExitPointEffect",
    "initial": "drive",
    "states": [
      {
        "name": "drive",
        "kind": "submachine",
        "machine": "SnapshotFromExitPointChild",
        "transitions": [
          {
            "trigger": {
              "kind": "exit_point",
              "exit_point": "done"
            },
            "target": "outside"
          }
        ]
      },
      {
        "name": "outside"
      }
    ]
  },
  "models": [
    {
      "name": "SnapshotFromExitPointChild",
      "initial": "active",
      "exit_points": [
        {
          "name": "done",
          "effects": [
            {
              "behavior": "exit_point_snapshot"
            }
          ]
        }
      ],
      "states": [
        {
          "name": "active",
          "transitions": [
            {
              "on": "finish",
              "target": "done"
            }
          ]
        }
      ]
    }
  ],
  "behaviors": {
    "exit_point_snapshot": [
      {
        "op": "snapshot"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "finish"
    }
  ],
  "expect": {
    "state": "/BehaviorSnapshotFromExitPointEffect/outside",
    "trace": [
      {
        "type": "dispatch",
        "event": "finish"
      },
      {
        "type": "snapshot",
        "state": "/BehaviorSnapshotFromExitPointEffect/drive/active"
      },
      {
        "type": "stable",
        "state": "/BehaviorSnapshotFromExitPointEffect/outside"
      }
    ]
  }
}
