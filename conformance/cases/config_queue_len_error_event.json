              {
                "behavior": "effect_error"
              }
            ]
          },
          {
            "on": "go",
            "target": "done",
            "effects": [
              {
                "behavior": "effect_go"
              }
            ]
          }
        ]
      },
      {
        "name": "failed"
      },
      {
        "name": "done"
      }
    ]
  },
  "instances": [
    {
      "id": "default",
      "config": {
        "queue": "len_error_once"
      }
    }
  ],
  "behaviors": {
