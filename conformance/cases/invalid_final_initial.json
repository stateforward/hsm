{
  "version": "hsm-conformance-v1",
  "name": "invalid_final_initial",
  "mode": "validation",
  "description": "Final states must not declare initial transitions.",
  "features": ["final", "initial", "validation"],
  "model": {
    "name": "InvalidFinalInitial",
    "initial": "done",
    "states": [
      {
        "name": "done",
        "kind": "final",
        "initial": "."
      }
    ]
  },
  "expect": {
    "validation": [
      {
        "code": "invalid_final_transition"
      }
    ]
  }
}
