{
  "version": "hsm-conformance-v1",
  "name": "submodel_timer_guard_all_ops_reentrancy",
  "description": "Child-model generated trigger/timer behavior-op reentrancy runs in child scope under a submachine boundary.",
  "features": [
    "submachine",
    "timer",
    "guard",
    "snapshot",
    "operation",
    "on_call",
    "queue",
    "reentrancy"
  ],
  "model": {
    "name": "SubmodelTimerGuardAllOpsReentrancy",
    "initial": "drive",
    "states": [
      {
        "name": "drive",
        "kind": "submachine",
        "machine": "ChildSubmodelTimerGuardAllOpsReentrancy"
      }
    ]
  },
  "models": [
    {
      "name": "ChildSubmodelTimerGuardAllOpsReentrancy",
      "initial": "idle",
      "operations": {
        "audit_call": {
          "behavior": "operation_audit"
        }
      },
      "attributes": {},
      "states": [
        {
          "name": "idle",
          "entry": [],
          "transitions": [
            {
              "trigger": {
                "kind": "after",
                "duration_ms": 10
              },
              "guard": {
                "behavior": "guard_all"
              },
              "target": "target"
            }
          ]
        },
        {
          "name": "target",
          "entry": [
            {
              "behavior": "entry_target"
            }
          ],
          "transitions": [
            {
              "on": "audit_dispatch",
              "target": "dispatch_seen",
              "effects": [
                {
                  "behavior": "effect_dispatch"
                }
              ]
            },
            {
              "on": "audit_raise",
              "target": "raise_seen",
              "effects": [
                {
                  "behavior": "effect_raise"
                }
              ]
            },
            {
              "trigger": {
                "kind": "on_call",
                "operation": "audit_call"
              },
              "target": "call_seen",
              "effects": [
                {
                  "behavior": "effect_call"
                }
              ]
            }
          ]
        },
        {
          "name": "dispatch_seen",
          "transitions": [
            {
              "on": "audit_raise",
              "target": "raise_seen",
              "effects": [
                {
                  "behavior": "effect_raise"
                }
              ]
            }
          ]
        },
        {
          "name": "raise_seen",
          "transitions": [
            {
              "trigger": {
                "kind": "on_call",
                "operation": "audit_call"
              },
              "target": "all_seen",
              "effects": [
                {
                  "behavior": "effect_call"
                }
              ]
            }
          ]
        },
        {
          "name": "call_seen"
        },
        {
          "name": "all_seen"
        }
      ]
    }
  ],
  "behaviors": {
    "operation_audit": [
      {
        "op": "trace",
        "value": "operation:audit"
      }
    ],
    "guard_all": [
      {
        "op": "snapshot"
      },
      {
        "op": "dispatch",
        "event": "audit_dispatch"
      },
      {
        "op": "raise",
        "event": "audit_raise"
      },
      {
        "op": "call",
        "name": "audit_call"
      },
      {
        "op": "return_value",
        "value": true
      }
    ],
    "effect_all": [
      {
        "op": "raise",
        "event": "audit_raise"
      },
      {
        "op": "call",
        "name": "audit_call"
      },
      {
        "op": "trace",
        "value": "effect:trigger"
      }
    ],
    "entry_target": [
      {
        "op": "trace",
        "value": "entry:target"
      }
    ],
    "effect_dispatch": [
      {
        "op": "trace",
        "value": "effect:dispatch"
      }
    ],
    "effect_raise": [
      {
        "op": "trace",
        "value": "effect:raise"
      }
    ],
    "effect_call": [
      {
        "op": "trace",
        "value": "effect:call"
      }
    ],
    "compute_all": [
      {
        "op": "snapshot"
      },
      {
        "op": "dispatch",
        "event": "audit_dispatch"
      },
      {
        "op": "raise",
        "event": "audit_raise"
      },
      {
        "op": "call",
        "name": "audit_call"
      },
      {
        "op": "return_value",
        "value": 10
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "tick",
      "millis": 20
    }
  ],
  "expect": {
    "state": "/SubmodelTimerGuardAllOpsReentrancy/drive/ChildSubmodelTimerGuardAllOpsReentrancy/all_seen",
    "trace": [
      {
        "type": "timer_scheduled"
      },
      {
        "type": "snapshot",
        "state": "/SubmodelTimerGuardAllOpsReentrancy/drive/ChildSubmodelTimerGuardAllOpsReentrancy/idle"
      },
      {
        "type": "dispatch",
        "event": "audit_dispatch"
      },
      {
        "type": "raise",
        "event": "audit_raise"
      },
      {
        "type": "trace",
        "value": "operation:audit"
      },
      {
        "type": "timer_fired"
      },
      {
        "type": "trace",
        "value": "entry:target"
      },
      {
        "type": "trace",
        "value": "effect:dispatch"
      },
      {
        "type": "trace",
        "value": "effect:raise"
      },
      {
        "type": "trace",
        "value": "effect:call"
      },
      {
        "type": "stable",
        "state": "/SubmodelTimerGuardAllOpsReentrancy/drive/ChildSubmodelTimerGuardAllOpsReentrancy/all_seen"
      }
    ]
  }
}
