{
  "version": "hsm-conformance-v1",
  "name": "invalid_on_extraneous_exit_point",
  "mode": "validation",
  "description": "An on trigger must not declare exit-point operands.",
  "features": ["exit_point", "validation"],
  "model": {
    "name": "InvalidOnExtraneousExitPoint",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "trigger": {
              "kind": "on",
              "event": "go",
              "exit_point": "done"
            },
            "target": "done"
          }
        ]
      },
      {
        "name": "done"
      }
    ]
  },
  "expect": {
    "validation": [
      {
        "code": "extraneous_trigger_operand"
      }
    ]
  }
}
