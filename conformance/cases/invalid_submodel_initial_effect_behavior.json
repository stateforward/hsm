{
  "version": "hsm-conformance-v1",
  "name": "invalid_submodel_initial_effect_behavior",
  "mode": "validation",
  "description": "Initial transition effect behavior references inside child models must be validated recursively.",
  "features": ["submachine", "initial", "validation"],
  "model": {
    "name": "InvalidSubmodelInitialEffectBehavior",
    "initial": "drive",
    "states": [
      {
        "name": "drive",
        "kind": "submachine",
        "machine": "ChildWithMissingInitialEffect"
      }
    ]
  },
  "models": [
    {
      "name": "ChildWithMissingInitialEffect",
      "initial": {
        "target": "idle",
        "effects": [
          {
            "behavior": "missing_child_initial_effect"
          }
        ]
      },
      "states": [
        {
          "name": "idle"
        }
      ]
    }
  ],
  "expect": {
    "validation": [
      {
        "code": "missing_behavior"
      }
    ]
  }
}
