{
  "version": "hsm-conformance-v1",
  "name": "timer_after_cancel_on_stop",
  "description": "Stopping an instance cancels an active after timer so it cannot fire after a later tick while stopped.",
  "features": [
    "timer",
    "after",
    "cancellation",
    "stop"
  ],
  "model": {
    "name": "TimerAfterStopCancel",
    "initial": "waiting",
    "states": [
      {
        "name": "waiting",
        "transitions": [
          {
            "trigger": {
              "kind": "after",
              "duration_ms": 100
            },
            "target": "timeout",
            "effects": [
              {
                "behavior": "effect_timeout"
              }
            ]
          }
        ]
      },
      {
        "name": "timeout"
      }
    ]
  },
  "behaviors": {
    "effect_timeout": [
      {
        "op": "trace",
        "value": "effect:timeout"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "stop"
    },
    {
      "op": "tick",
      "millis": 200
    }
  ],
  "expect": {
    "state": "",
    "trace": [
      {
        "type": "timer_scheduled"
      },
      {
        "type": "stop"
      },
      {
        "type": "timer_cancelled"
      },
      {
        "type": "stable",
        "state": ""
      }
    ]
  }
}
