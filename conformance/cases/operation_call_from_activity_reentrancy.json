{
  "version": "hsm-conformance-v1",
  "name": "operation_call_from_activity_reentrancy",
  "description": "An operation called from an activity queues its on_call event through the normal event path while the state is active.",
  "features": [
    "operation",
    "on_call",
    "activity",
    "async",
    "queue",
    "reentrancy"
  ],
  "model": {
    "name": "OperationCallFromActivityReentrancy",
    "initial": "active",
    "operations": {
      "audit": {
        "behavior": "operation_audit"
      }
    },
    "states": [
      {
        "name": "active",
        "activity": [
          {
            "behavior": "activity_calls_audit"
          }
        ],
        "transitions": [
          {
            "trigger": {
              "kind": "on_call",
              "operation": "audit"
            },
            "target": "handled",
            "effects": [
              {
                "behavior": "effect_audit"
              }
            ]
          }
        ]
      },
      {
        "name": "handled",
        "entry": [
          {
            "behavior": "entry_handled"
          }
        ]
      }
    ]
  },
  "behaviors": {
    "operation_audit": [
      {
        "op": "trace",
        "value": "operation:audit"
      }
    ],
    "activity_calls_audit": [
      {
        "op": "yield"
      },
      {
        "op": "call",
        "name": "audit"
      },
      {
        "op": "trace",
        "value": "activity:after-call"
      }
    ],
    "effect_audit": [
      {
        "op": "trace",
        "value": "effect:audit"
      }
    ],
    "entry_handled": [
      {
        "op": "trace",
        "value": "entry:handled"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "sleep",
      "millis": 10
    }
  ],
  "expect": {
    "state": "/OperationCallFromActivityReentrancy/handled",
    "queue": {
      "operation_call_from_activity": "queued_while_activity_state_is_active"
    },
    "trace": [
      {
        "type": "trace",
        "value": "operation:audit"
      },
      {
        "type": "trace",
        "value": "effect:audit"
      },
      {
        "type": "trace",
        "value": "entry:handled"
      },
      {
        "type": "stable",
        "state": "/OperationCallFromActivityReentrancy/handled"
      }
    ]
  }
}
