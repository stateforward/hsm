{
  "version": "hsm-conformance-v1",
  "name": "nested_completion_effect_call_reentrancy",
  "description": "A behavior-side operation call from a state-owned completion transition effect queues its on_call event until the completion target is entered.",
  "features": ["completion", "final", "nested", "operation", "on_call", "queue", "reentrancy"],
  "model": {"name": "NestedCompletionEffectCallReentrancy", "initial": "parent", "operations": {"audit": {"behavior": "operation_audit"}}, "states": [{"name": "parent", "initial": "work", "states": [{"name": "work", "transitions": [{"on": "finish", "target": "../done"}]}, {"name": "done", "kind": "final"}], "transitions": [{"trigger": {"kind": "completion"}, "target": "complete", "effects": [{"behavior": "completion_call"}]}]}, {"name": "complete", "entry": [{"behavior": "entry_complete"}], "transitions": [{"trigger": {"kind": "on_call", "operation": "audit"}, "target": "audited", "effects": [{"behavior": "effect_audit"}]}]}, {"name": "audited"}]},
  "behaviors": {"operation_audit": [{"op": "trace", "value": "operation:audit"}], "completion_call": [{"op": "call", "name": "audit"}, {"op": "trace", "value": "effect:completion"}], "entry_complete": [{"op": "trace", "value": "entry:complete"}], "effect_audit": [{"op": "trace", "value": "effect:audit"}]},
  "script": [{"op": "start"}, {"op": "dispatch", "event": "finish"}],
  "expect": {"state": "/NestedCompletionEffectCallReentrancy/audited", "trace": [{"type": "dispatch", "event": "finish"}, {"type": "trace", "value": "operation:audit"}, {"type": "trace", "value": "effect:completion"}, {"type": "trace", "value": "entry:complete"}, {"type": "trace", "value": "effect:audit"}, {"type": "stable", "state": "/NestedCompletionEffectCallReentrancy/audited"}]}
}
