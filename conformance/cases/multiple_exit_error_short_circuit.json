{
  "version": "hsm-conformance-v1",
  "name": "multiple_exit_error_short_circuit",
  "description": "A failing exit behavior prevents later exit behaviors, transition effects, and target entry from running.",
  "features": ["exit", "effect", "entry", "error", "selection_order"],
  "model": {
    "name": "MultipleExitErrorShortCircuit",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "exit": [
          {
            "behavior": "exit_before"
          },
          {
            "behavior": "exit_fail"
          },
          {
            "behavior": "exit_after"
          }
        ],
        "transitions": [
          {
            "on": "go",
            "target": "done",
            "effects": [
              {
                "behavior": "effect_go"
              }
            ]
          }
        ]
      },
      {
        "name": "done",
        "entry": [
          {
            "behavior": "entry_done"
          }
        ]
      }
    ]
  },
  "behaviors": {
    "exit_before": [
      {
        "op": "trace",
        "value": "exit:before"
      }
    ],
    "exit_fail": [
      {
        "op": "trace",
        "value": "exit:fail"
      },
      {
        "op": "raise",
        "code": "exit_error",
        "value": "exit boom"
      }
    ],
    "exit_after": [
      {
        "op": "trace",
        "value": "exit:after"
      }
    ],
    "effect_go": [
      {
        "op": "trace",
        "value": "effect:go"
      }
    ],
    "entry_done": [
      {
        "op": "trace",
        "value": "entry:done"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "go"
    }
  ],
  "expect": {
    "state": "/MultipleExitErrorShortCircuit/idle",
    "error": {
      "code": "exit_error",
      "message_contains": "exit boom"
    },
    "trace": [
      {
        "type": "dispatch",
        "event": "go"
      },
      {
        "type": "trace",
        "value": "exit:before"
      },
      {
        "type": "trace",
        "value": "exit:fail"
      },
      {
        "type": "error",
        "code": "exit_error"
      },
      {
        "type": "stable",
        "state": "/MultipleExitErrorShortCircuit/idle"
      }
    ]
  }
}
