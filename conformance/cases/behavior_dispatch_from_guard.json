{
  "version": "hsm-conformance-v1",
  "name": "behavior_dispatch_from_guard",
  "description": "A behavior dispatch op from a true guard is queued and processed after the guarded transition completes.",
  "features": ["guard", "queue", "reentrancy"],
  "model": {
    "name": "BehaviorDispatchFromGuard",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "go",
            "guard": {
              "behavior": "guard_dispatch"
            },
            "target": "waiting"
          }
        ]
      },
      {
        "name": "waiting",
        "transitions": [
          {
            "on": "audit",
            "target": "done",
            "effects": [
              {
                "behavior": "effect_audit"
              }
            ]
          }
        ]
      },
      {
        "name": "done"
      }
    ]
  },
  "behaviors": {
    "guard_dispatch": [
      {
        "op": "dispatch",
        "event": "audit"
      },
      {
        "op": "trace",
        "value": "guard:true"
      },
      {
        "op": "return_value",
        "value": true
      }
    ],
    "effect_audit": [
      {
        "op": "trace",
        "value": "effect:audit"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "go"
    }
  ],
  "expect": {
    "state": "/BehaviorDispatchFromGuard/done",
    "trace": [
      {
        "type": "dispatch",
        "event": "go"
      },
      {
        "type": "dispatch",
        "event": "audit"
      },
      {
        "type": "trace",
        "value": "guard:true"
      },
      {
        "type": "trace",
        "value": "effect:audit"
      },
      {
        "type": "stable",
        "state": "/BehaviorDispatchFromGuard/done"
      }
    ]
  }
}
