{
  "version": "hsm-conformance-v1",
  "name": "invalid_submodel_guard_behavior",
  "mode": "validation",
  "description": "Guard behavior references inside child models must be validated recursively.",
  "features": ["submachine", "guard", "validation"],
  "model": {
    "name": "InvalidSubmodelGuardBehavior",
    "initial": "drive",
    "states": [
      {
        "name": "drive",
        "kind": "submachine",
        "machine": "ChildWithMissingGuardBehavior"
      }
    ]
  },
  "models": [
    {
      "name": "ChildWithMissingGuardBehavior",
      "initial": "idle",
      "states": [
        {
          "name": "idle",
          "transitions": [
            {
              "on": "go",
              "guard": {
                "behavior": "missing_child_guard"
              },
              "target": "done"
            }
          ]
        },
        {
          "name": "done"
        }
      ]
    }
  ],
  "expect": {
    "validation": [
      {
        "code": "missing_behavior"
      }
    ]
  }
}
