{
  "version": "hsm-conformance-v1",
  "name": "submachine_child_false_guard_falls_through_to_parent_defer",
  "description": "A false child-model guard allows selection to continue to the containing submachine state's defer declaration.",
  "features": [
    "defer",
    "queue",
    "submachine",
    "guard",
    "selection_order"
  ],
  "model": {
    "name": "SubmachineChildFalseGuardFallsThroughToParentDefer",
    "initial": "drive",
    "states": [
      {
        "name": "drive",
        "kind": "submachine",
        "machine": "ChildFalseGuardFallsThroughToParentDefer",
        "defer": [
          "maybe"
        ],
        "transitions": [
          {
            "on": "release",
            "target": "outside",
            "effects": [
              {
                "behavior": "effect_release"
              }
            ]
          }
        ]
      },
      {
        "name": "outside",
        "entry": [
          {
            "behavior": "entry_outside"
          }
        ],
        "transitions": [
          {
            "on": "maybe",
            "target": "done",
            "effects": [
              {
                "behavior": "effect_maybe"
              }
            ]
          }
        ]
      },
      {
        "name": "done",
        "entry": [
          {
            "behavior": "entry_done"
          }
        ]
      }
    ]
  },
  "models": [
    {
      "name": "ChildFalseGuardFallsThroughToParentDefer",
      "initial": "idle",
      "states": [
        {
          "name": "idle",
          "transitions": [
            {
              "on": "maybe",
              "guard": {
                "behavior": "guard_false"
              },
              "target": "wrong"
            }
          ]
        },
        {
          "name": "wrong",
          "entry": [
            {
              "behavior": "entry_wrong"
            }
          ]
        }
      ]
    }
  ],
  "behaviors": {
    "guard_false": [
      {
        "op": "trace",
        "value": "guard:false"
      },
      {
        "op": "return_value",
        "value": false
      }
    ],
    "effect_release": [
      {
        "op": "trace",
        "value": "effect:release"
      }
    ],
    "entry_outside": [
      {
        "op": "trace",
        "value": "entry:outside"
      }
    ],
    "effect_maybe": [
      {
        "op": "trace",
        "value": "effect:maybe"
      }
    ],
    "entry_done": [
      {
        "op": "trace",
        "value": "entry:done"
      }
    ],
    "entry_wrong": [
      {
        "op": "trace",
        "value": "entry:wrong"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "maybe"
    },
    {
      "op": "dispatch",
      "event": "release"
    }
  ],
  "expect": {
    "state": "/SubmachineChildFalseGuardFallsThroughToParentDefer/done",
    "queue": {
      "submachine_false_guard": "falls_through_to_containing_state_defer"
    },
    "trace": [
      {
        "type": "dispatch",
        "event": "maybe"
      },
      {
        "type": "trace",
        "value": "guard:false"
      },
      {
        "type": "defer",
        "event": "maybe"
      },
      {
        "type": "dispatch",
        "event": "release"
      },
      {
        "type": "undefer",
        "event": "maybe"
      },
      {
        "type": "trace",
        "value": "effect:release"
      },
      {
        "type": "trace",
        "value": "entry:outside"
      },
      {
        "type": "trace",
        "value": "effect:maybe"
      },
      {
        "type": "trace",
        "value": "entry:done"
      },
      {
        "type": "stable",
        "state": "/SubmachineChildFalseGuardFallsThroughToParentDefer/done"
      }
    ]
  }
}
