{
  "version": "hsm-conformance-v1",
  "name": "behavior_dispatch_from_operation_body",
  "description": "A behavior dispatch op from an operation body queues a regular event for normal transition selection.",
  "features": ["operation", "queue", "reentrancy"],
  "model": {
    "name": "BehaviorDispatchFromOperationBody",
    "initial": "idle",
    "operations": {
      "kick": {
        "behavior": "operation_kick"
      }
    },
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "audit",
            "target": "done",
            "effects": [
              {
                "behavior": "effect_audit"
              }
            ]
          }
        ]
      },
      {
        "name": "done"
      }
    ]
  },
  "behaviors": {
    "operation_kick": [
      {
        "op": "dispatch",
        "event": "audit"
      },
      {
        "op": "trace",
        "value": "operation:kick"
      }
    ],
    "effect_audit": [
      {
        "op": "trace",
        "value": "effect:audit"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "call",
      "operation": "kick"
    }
  ],
  "expect": {
    "state": "/BehaviorDispatchFromOperationBody/done",
    "trace": [
      {
        "type": "call",
        "operation": "kick"
      },
      {
        "type": "dispatch",
        "event": "audit"
      },
      {
        "type": "trace",
        "value": "effect:audit"
      },
      {
        "type": "trace",
        "value": "operation:kick"
      },
      {
        "type": "stable",
        "state": "/BehaviorDispatchFromOperationBody/done"
      }
    ]
  }
}
