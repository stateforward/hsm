{
  "version": "hsm-conformance-v1",
  "name": "behavior_dispatch_from_exit",
  "description": "A behavior dispatch op from exit is queued and processed after the triggering transition completes.",
  "features": ["exit", "queue", "reentrancy"],
  "model": {
    "name": "BehaviorDispatchFromExit",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "exit": [
          {
            "behavior": "exit_dispatch"
          }
        ],
        "transitions": [
          {
            "on": "go",
            "target": "waiting"
          }
        ]
      },
      {
        "name": "waiting",
        "transitions": [
          {
            "on": "audit",
            "target": "done",
            "effects": [
              {
                "behavior": "effect_audit"
              }
            ]
          }
        ]
      },
      {
        "name": "done"
      }
    ]
  },
  "behaviors": {
    "exit_dispatch": [
      {
        "op": "dispatch",
        "event": "audit"
      },
      {
        "op": "trace",
        "value": "exit:idle"
      }
    ],
    "effect_audit": [
      {
        "op": "trace",
        "value": "effect:audit"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "go"
    }
  ],
  "expect": {
    "state": "/BehaviorDispatchFromExit/done",
    "trace": [
      {
        "type": "dispatch",
        "event": "go"
      },
      {
        "type": "dispatch",
        "event": "audit"
      },
      {
        "type": "trace",
        "value": "exit:idle"
      },
      {
        "type": "trace",
        "value": "effect:audit"
      },
      {
        "type": "stable",
        "state": "/BehaviorDispatchFromExit/done"
      }
    ]
  }
}
