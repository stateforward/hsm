{
  "version": "hsm-conformance-v1",
  "name": "config_queue_dispatch_all_uses_recipient_queues",
  "description": "A caller-originated dispatch_all enqueues each regular event through the started recipient instances' configured queues.",
  "features": [
    "queue",
    "broadcast"
  ],
  "model": {
    "name": "ConfigQueueDispatchAllUsesRecipientQueues",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "audit",
            "target": "done",
            "effects": [
              {
                "behavior": "effect_audit"
              }
            ]
          }
        ]
      },
      {
        "name": "done",
        "entry": [
          {
            "behavior": "entry_done"
          }
        ]
      }
    ]
  },
  "instances": [
    {
      "id": "one",
      "config": {
        "queue": "trace_fifo"
      }
    },
    {
      "id": "two",
      "config": {
        "queue": "trace_fifo"
      }
    },
    {
      "id": "unstarted",
      "config": {
        "queue": "trace_fifo"
      }
    }
  ],
  "behaviors": {
    "effect_audit": [
      {
        "op": "trace",
        "value": "effect:audit"
      }
    ],
    "entry_done": [
      {
        "op": "trace",
        "value": "entry:done"
      }
    ]
  },
  "script": [
    {
      "op": "start",
      "instance": "one"
    },
    {
      "op": "start",
      "instance": "two"
    },
    {
      "op": "dispatch_all",
      "event": "audit"
    }
  ],
  "expect": {
    "states": {
      "one": "/ConfigQueueDispatchAllUsesRecipientQueues/done",
      "two": "/ConfigQueueDispatchAllUsesRecipientQueues/done",
      "unstarted": ""
    },
    "trace": [
      {
        "type": "dispatch",
        "event": "audit",
        "target": "all"
      },
      {
        "type": "trace",
        "value": "queue:push:audit"
      },
      {
        "type": "trace",
        "value": "queue:pop:audit"
      },
      {
        "type": "trace",
        "value": "effect:audit"
      },
      {
        "type": "trace",
        "value": "entry:done"
      },
      {
        "type": "trace",
        "value": "queue:push:audit"
      },
      {
        "type": "trace",
        "value": "queue:pop:audit"
      },
      {
        "type": "trace",
        "value": "effect:audit"
      },
      {
        "type": "trace",
        "value": "entry:done"
      },
      {
        "type": "stable",
        "state": "all"
      }
    ]
  }
}
