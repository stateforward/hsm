{
  "version": "hsm-conformance-v1",
  "name": "invalid_on_call_extraneous_behavior",
  "mode": "validation",
  "description": "An on_call trigger must not declare behavior operands.",
  "features": ["operation", "on_call", "validation"],
  "model": {
    "name": "InvalidOnCallExtraneousBehavior",
    "initial": "idle",
    "operations": {
      "approve": {
        "behavior": "operation_approve"
      }
    },
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "trigger": {
              "kind": "on_call",
              "operation": "approve",
              "behavior": "operation_approve"
            },
            "target": "done"
          }
        ]
      },
      {
        "name": "done"
      }
    ]
  },
  "behaviors": {
    "operation_approve": [
      {
        "op": "trace",
        "value": "operation:approve"
      }
    ]
  },
  "expect": {
    "validation": [
      {
        "code": "extraneous_trigger_operand"
      }
    ]
  }
}
