{
  "version": "hsm-conformance-v1",
  "name": "behavior_raise_from_guard_false_replays",
  "description": "A normal internal event raised from a false guard is replayed after selection settles on a later transition that leaves the source active.",
  "features": ["guard", "queue", "reentrancy", "selection_order"],
  "model": {
    "name": "BehaviorRaiseFromGuardFalseReplays",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "go",
            "guard": {"behavior": "guard_raise_false"},
            "target": "done"
          },
          {
            "on": "go",
            "kind": "internal",
            "effects": [{"behavior": "effect_fallback"}]
          },
          {
            "on": "audit",
            "target": "audit_handled",
            "effects": [{"behavior": "effect_audit"}]
          }
        ]
      },
      {"name": "done"},
      {"name": "audit_handled", "entry": [{"behavior": "entry_audit_handled"}]}
    ]
  },
  "behaviors": {
    "guard_raise_false": [
      {"op": "trace", "value": "guard:before-raise"},
      {"op": "raise", "event": "audit"},
      {"op": "trace", "value": "guard:after-raise"},
      {"op": "return_value", "value": false}
    ],
    "effect_fallback": [{"op": "trace", "value": "effect:fallback"}],
    "effect_audit": [{"op": "trace", "value": "effect:audit"}],
    "entry_audit_handled": [{"op": "trace", "value": "entry:audit-handled"}]
  },
  "script": [{"op": "start"}, {"op": "dispatch", "event": "go"}],
  "expect": {
    "state": "/BehaviorRaiseFromGuardFalseReplays/audit_handled",
    "trace": [
      {"type": "dispatch", "event": "go"},
      {"type": "trace", "value": "guard:before-raise"},
      {"type": "raise", "event": "audit"},
      {"type": "trace", "value": "guard:after-raise"},
      {"type": "trace", "value": "effect:fallback"},
      {"type": "trace", "value": "effect:audit"},
      {"type": "trace", "value": "entry:audit-handled"},
      {"type": "stable", "state": "/BehaviorRaiseFromGuardFalseReplays/audit_handled"}
    ]
  }
}
