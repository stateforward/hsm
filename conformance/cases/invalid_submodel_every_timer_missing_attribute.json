{
  "version": "hsm-conformance-v1",
  "name": "invalid_submodel_every_timer_missing_attribute",
  "mode": "validation",
  "description": "Timer attribute references inside child models must be validated recursively.",
  "features": ["submachine", "timer", "every", "validation"],
  "model": {
    "name": "InvalidSubmodelEveryTimerMissingAttribute",
    "initial": "drive",
    "states": [
      {
        "name": "drive",
        "kind": "submachine",
        "machine": "ChildWithMissingEveryTimerAttribute"
      }
    ]
  },
  "models": [
    {
      "name": "ChildWithMissingEveryTimerAttribute",
      "initial": "waiting",
      "states": [
        {
          "name": "waiting",
          "transitions": [
            {
              "trigger": {
                "kind": "every",
                "attribute": "missing_interval"
              },
              "target": "done"
            }
          ]
        },
        {
          "name": "done"
        }
      ]
    }
  ],
  "expect": {
    "validation": [
      {
        "code": "missing_timer_attribute"
      }
    ]
  }
}
