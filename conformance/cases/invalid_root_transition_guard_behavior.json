{
  "version": "hsm-conformance-v1",
  "name": "invalid_root_transition_guard_behavior",
  "mode": "validation",
  "description": "Root-owned transition guard behavior references must be validated.",
  "features": ["root_transition", "guard", "validation"],
  "model": {
    "name": "InvalidRootTransitionGuardBehavior",
    "initial": "idle",
    "states": [
      {"name": "idle"},
      {"name": "done"}
    ],
    "transitions": [
      {
        "on": "go",
        "guard": {"behavior": "missing_root_guard"},
        "target": "done"
      }
    ]
  },
  "expect": {
    "validation": [{"code": "missing_behavior"}]
  }
}
