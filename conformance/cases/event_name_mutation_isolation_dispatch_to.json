{
  "version": "hsm-conformance-v1",
  "name": "event_name_mutation_isolation_dispatch_to",
  "description": "Mutating the event name in one multi-target dispatch_to recipient remains recipient-local and does not affect sibling recipient routing.",
  "features": [
    "event_ownership",
    "dispatch_to",
    "guard"
  ],
  "model": {
    "name": "EventNameMutationIsolationDispatchTo",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "mutate",
            "guard": {
              "behavior": "name_is_mutate"
            },
            "target": "done",
            "effects": [
              {
                "behavior": "rename_event"
              }
            ]
          },
          {
            "on": "changed",
            "target": "leaked",
            "effects": [
              {
                "behavior": "effect_leaked"
              }
            ]
          }
        ]
      },
      {
        "name": "done"
      },
      {
        "name": "leaked"
      }
    ]
  },
  "instances": [
    {
      "id": "first"
    },
    {
      "id": "second"
    }
  ],
  "behaviors": {
    "name_is_mutate": [
      {
        "op": "trace",
        "value": "guard:name-mutate"
      },
      {
        "op": "event_name_equals",
        "value": "mutate"
      }
    ],
    "rename_event": [
      {
        "op": "event_metadata_set",
        "name": "name",
        "value": "changed"
      },
      {
        "op": "trace",
        "value": "effect:renamed"
      }
    ],
    "effect_leaked": [
      {
        "op": "trace",
        "value": "effect:leaked"
      }
    ]
  },
  "script": [
    {
      "op": "start",
      "instance": "first"
    },
    {
      "op": "start",
      "instance": "second"
    },
    {
      "op": "dispatch_to",
      "targets": [
        "first",
        "second"
      ],
      "event": "mutate"
    }
  ],
  "expect": {
    "states": {
      "first": "/EventNameMutationIsolationDispatchTo/done",
      "second": "/EventNameMutationIsolationDispatchTo/done"
    },
    "trace": [
      {
        "type": "dispatch",
        "event": "mutate",
        "target": [
          "first",
          "second"
        ]
      },
      {
        "type": "trace",
        "value": "guard:name-mutate"
      },
      {
        "type": "trace",
        "value": "effect:renamed"
      },
      {
        "type": "trace",
        "value": "guard:name-mutate"
      },
      {
        "type": "trace",
        "value": "effect:renamed"
      },
      {
        "type": "stable",
        "state": "targets:first,second"
      }
    ]
  }
}
