{
  "version": "hsm-conformance-v1",
  "name": "submodel_timer_guard_and_effect_set_attr_generated_trigger_replay",
  "description": "Attribute work from child-model timer guard and effect behavior replays through child-local generated triggers after the timer target is active.",
  "features": [
    "submachine",
    "timer",
    "after",
    "attribute",
    "guard",
    "effect",
    "on_set",
    "when",
    "queue"
  ],
  "model": {
    "name": "SubmodelTimerGuardAndEffectSetAttrGeneratedTriggerReplay",
    "initial": "drive",
    "states": [
      {
        "name": "drive",
        "kind": "submachine",
        "machine": "ChildTimerSetAttrReplay"
      }
    ]
  },
  "models": [
    {
      "name": "ChildTimerSetAttrReplay",
      "initial": "waiting",
      "attributes": {
        "flag": {
          "type": "boolean",
          "default": false
        },
        "ready": {
          "type": "boolean",
          "default": false
        }
      },
      "states": [
        {
          "name": "waiting",
          "transitions": [
            {
              "trigger": {
                "kind": "after",
                "duration_ms": 10
              },
              "guard": {
                "behavior": "guard_set"
              },
              "target": "target",
              "effects": [
                {
                  "behavior": "effect_set"
                }
              ]
            }
          ]
        },
        {
          "name": "target",
          "transitions": [
            {
              "trigger": {
                "kind": "on_set",
                "attribute": "flag"
              },
              "target": "flag_seen",
              "effects": [
                {
                  "behavior": "effect_flag"
                }
              ]
            }
          ]
        },
        {
          "name": "flag_seen",
          "transitions": [
            {
              "trigger": {
                "kind": "when",
                "behavior": "ready_when"
              },
              "target": "all_seen",
              "effects": [
                {
                  "behavior": "effect_ready"
                }
              ]
            }
          ]
        },
        {
          "name": "all_seen"
        }
      ]
    }
  ],
  "behaviors": {
    "guard_set": [
      {
        "op": "set_attr",
        "name": "flag",
        "value": true
      },
      {
        "op": "trace",
        "value": "guard:set"
      },
      {
        "op": "return_value",
        "value": true
      }
    ],
    "effect_set": [
      {
        "op": "set_attr",
        "name": "ready",
        "value": true
      },
      {
        "op": "trace",
        "value": "effect:set"
      }
    ],
    "ready_when": [
      {
        "op": "return_equals",
        "name": "ready",
        "value": true
      }
    ],
    "effect_flag": [
      {
        "op": "trace",
        "value": "effect:flag"
      }
    ],
    "effect_ready": [
      {
        "op": "trace",
        "value": "effect:ready"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "tick",
      "millis": 20
    }
  ],
  "expect": {
    "state": "/SubmodelTimerGuardAndEffectSetAttrGeneratedTriggerReplay/drive/ChildTimerSetAttrReplay/all_seen",
    "attributes": {
      "flag": true,
      "ready": true
    },
    "trace": [
      {
        "type": "timer_scheduled"
      },
      {
        "type": "trace",
        "value": "guard:set"
      },
      {
        "type": "timer_fired"
      },
      {
        "type": "trace",
        "value": "effect:set"
      },
      {
        "type": "trace",
        "value": "effect:flag"
      },
      {
        "type": "trace",
        "value": "effect:ready"
      },
      {
        "type": "stable",
        "state": "/SubmodelTimerGuardAndEffectSetAttrGeneratedTriggerReplay/drive/ChildTimerSetAttrReplay/all_seen"
      }
    ]
  }
}
