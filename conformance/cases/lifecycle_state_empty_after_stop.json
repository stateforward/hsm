{
  "version": "hsm-conformance-v1",
  "name": "lifecycle_state_empty_after_stop",
  "description": "A machine has no observable active state after it is stopped.",
  "features": ["lifecycle", "stop"],
  "model": {
    "name": "LifecycleStateEmptyAfterStop",
    "initial": "idle",
    "states": [
      {
        "name": "idle"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "stop"
    }
  ],
  "expect": {
    "state": "",
    "trace": [
      {
        "type": "start"
      },
      {
        "type": "stop"
      },
      {
        "type": "stable",
        "state": ""
      }
    ]
  }
}
