{
  "version": "hsm-conformance-v1",
  "name": "invalid_missing_effect_behavior",
  "mode": "validation",
  "description": "Transition effect behavior references must resolve to declared portable behavior programs.",
  "features": [
    "validation"
  ],
  "model": {
    "name": "InvalidMissingEffectBehavior",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "go",
            "target": "done",
            "effects": [
              {
                "behavior": "missing_effect"
              }
            ]
          }
        ]
      },
      {
        "name": "done"
      }
    ]
  },
  "expect": {
    "validation": [
      {
        "code": "missing_behavior"
      }
    ]
  }
}
