      },
      {
        "type": "trace",
        "value": "effect:work"
      },
      {
        "type": "trace",
        "value": "entry:done"
      },
      {
        "type": "stable",
        "state": "/DeferReplayAfterEntryPointCompositeTargetResolution/drive/comp/done"
      }
    ]
