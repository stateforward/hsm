{
  "version": "hsm-conformance-v1",
  "name": "invalid_empty_transition_effects",
  "mode": "validation",
  "description": "Transition effects arrays must not be empty when present.",
  "features": ["validation"],
  "model": {
    "name": "InvalidEmptyTransitionEffects",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "go",
            "target": "done",
            "effects": []
          }
        ]
      },
      {
        "name": "done"
      }
    ]
  },
  "expect": {
    "validation": [
      {
        "code": "empty_behavior_array"
      }
    ]
  }
}
