{
  "version": "hsm-conformance-v1",
  "name": "invalid_final_activity",
  "mode": "validation",
  "description": "Final states must not declare activities.",
  "features": ["final", "activity", "validation"],
  "model": {
    "name": "InvalidFinalActivity",
    "initial": "done",
    "states": [
      {
        "name": "done",
        "kind": "final",
        "activity": [
          {
            "behavior": "activity_done"
          }
        ]
      }
    ]
  },
  "behaviors": {
    "activity_done": [
      {
        "op": "trace",
        "value": "activity:done"
      }
    ]
  },
  "expect": {
    "validation": [
      {
        "code": "invalid_final_transition"
      }
    ]
  }
}
