{
  "version": "hsm-conformance-v1",
  "name": "invalid_submodel_on_set_missing_attribute",
  "mode": "validation",
  "description": "on_set triggers inside child models must validate attribute references recursively.",
  "features": ["submachine", "attribute", "on_set", "validation"],
  "model": {
    "name": "InvalidSubmodelOnSetMissingAttribute",
    "initial": "drive",
    "states": [
      {
        "name": "drive",
        "kind": "submachine",
        "machine": "ChildWithMissingOnSetAttribute"
      }
    ]
  },
  "models": [
    {
      "name": "ChildWithMissingOnSetAttribute",
      "initial": "idle",
      "states": [
        {
          "name": "idle",
          "transitions": [
            {
              "trigger": {
                "kind": "on_set",
                "attribute": "missing"
              },
              "target": "done"
            }
          ]
        },
        {
          "name": "done"
        }
      ]
    }
  ],
  "expect": {
    "validation": [
      {
        "code": "missing_attribute"
      }
    ]
  }
}
