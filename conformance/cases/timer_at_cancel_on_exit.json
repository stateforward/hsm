{
  "version": "hsm-conformance-v1",
  "name": "timer_at_cancel_on_exit",
  "description": "An at timer using the default clock is cancelled when its source state exits before firing.",
  "features": ["timer", "at", "cancellation"],
  "model": {
    "name": "TimerAtCancelOnExit",
    "initial": "waiting",
    "states": [
      {
        "name": "waiting",
        "transitions": [
          {
            "trigger": {"kind": "at", "time_ms": 100},
            "target": "timeout"
          },
          {
            "on": "leave",
            "target": "done"
          }
        ]
      },
      {"name": "timeout"},
      {"name": "done", "entry": [{"behavior": "entry_done"}]}
    ]
  },
  "behaviors": {
    "entry_done": [{"op": "trace", "value": "enter:done"}]
  },
  "script": [{"op": "start"}, {"op": "dispatch", "event": "leave"}, {"op": "tick", "millis": 200}],
  "expect": {
    "state": "/TimerAtCancelOnExit/done",
    "trace": [
      {"type": "timer_scheduled"},
      {"type": "dispatch", "event": "leave"},
      {"type": "timer_cancelled"},
      {"type": "trace", "value": "enter:done"},
      {"type": "stable", "state": "/TimerAtCancelOnExit/done"}
    ]
  }
}
