{
  "version": "hsm-conformance-v1",
  "name": "completion_effect_raise_reentrancy",
  "description": "A normal internal event raised from a completion transition effect is processed after completion routing reaches its target.",
  "features": ["completion", "final", "queue", "reentrancy"],
  "model": {"name": "CompletionEffectRaiseReentrancy", "initial": "work", "states": [{"name": "work", "transitions": [{"on": "finish", "target": "done"}]}, {"name": "done", "kind": "final"}, {"name": "complete", "entry": [{"behavior": "entry_complete"}], "transitions": [{"on": "audit", "target": "audited", "effects": [{"behavior": "effect_audit"}]}]}, {"name": "audited"}], "transitions": [{"trigger": {"kind": "completion"}, "target": "complete", "effects": [{"behavior": "completion_raise"}]}]},
  "behaviors": {"completion_raise": [{"op": "raise", "event": "audit"}, {"op": "trace", "value": "effect:completion"}], "entry_complete": [{"op": "trace", "value": "entry:complete"}], "effect_audit": [{"op": "trace", "value": "effect:audit"}]},
  "script": [{"op": "start"}, {"op": "dispatch", "event": "finish"}],
  "expect": {"state": "/CompletionEffectRaiseReentrancy/audited", "trace": [{"type": "dispatch", "event": "finish"}, {"type": "raise", "event": "audit"}, {"type": "trace", "value": "effect:completion"}, {"type": "trace", "value": "entry:complete"}, {"type": "trace", "value": "effect:audit"}, {"type": "stable", "state": "/CompletionEffectRaiseReentrancy/audited"}]}
}
