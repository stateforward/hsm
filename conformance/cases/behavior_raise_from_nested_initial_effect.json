{
  "version": "hsm-conformance-v1",
  "name": "behavior_raise_from_nested_initial_effect",
  "description": "A normal internal event raised from a nested composite initial effect is processed after the nested initial target entry completes.",
  "features": ["nested", "initial", "queue", "reentrancy"],
  "model": {
    "name": "BehaviorRaiseFromNestedInitialEffect",
    "initial": "parent",
    "states": [
      {
        "name": "parent",
        "entry": [{"behavior": "entry_parent"}],
        "initial": {
          "target": "child",
          "effects": [{"behavior": "nested_initial_raise"}]
        },
        "states": [
          {
            "name": "child",
            "entry": [{"behavior": "entry_child"}],
            "transitions": [
              {
                "on": "audit",
                "target": "../done",
                "effects": [{"behavior": "effect_audit"}]
              }
            ]
          },
          {"name": "done"}
        ]
      }
    ]
  },
  "behaviors": {
    "entry_parent": [{"op": "trace", "value": "entry:parent"}],
    "nested_initial_raise": [
      {"op": "raise", "event": "audit"},
      {"op": "trace", "value": "initial:parent"}
    ],
    "entry_child": [{"op": "trace", "value": "entry:child"}],
    "effect_audit": [{"op": "trace", "value": "effect:audit"}]
  },
  "script": [{"op": "start"}],
  "expect": {
    "state": "/BehaviorRaiseFromNestedInitialEffect/parent/done",
    "trace": [
      {"type": "trace", "value": "entry:parent"},
      {"type": "raise", "event": "audit"},
      {"type": "trace", "value": "initial:parent"},
      {"type": "trace", "value": "entry:child"},
      {"type": "trace", "value": "effect:audit"},
      {"type": "stable", "state": "/BehaviorRaiseFromNestedInitialEffect/parent/done"}
    ]
  }
}
