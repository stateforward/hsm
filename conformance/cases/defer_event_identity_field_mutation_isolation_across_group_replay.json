{
  "version": "hsm-conformance-v1",
  "name": "defer_event_identity_field_mutation_isolation_across_group_replay",
  "description": "A group-dispatched event object that is deferred by multiple recipients preserves reserved id field isolation when each recipient later replays it.",
  "features": [
    "defer",
    "event_ownership",
    "group"
  ],
  "model": {
    "name": "DeferEventIdentityFieldMutationIsolationAcrossGroupReplay",
    "initial": "hold",
    "states": [
      {
        "name": "hold",
        "defer": [
          "audit"
        ],
        "transitions": [
          {
            "on": "release",
            "target": "ready"
          }
        ]
      },
      {
        "name": "ready",
        "transitions": [
          {
            "on": "audit",
            "guard": {
              "behavior": "id_is_original"
            },
            "target": "done",
            "effects": [
              {
                "behavior": "mutate_id"
              }
            ]
          },
          {
            "on": "audit",
            "target": "leaked",
            "effects": [
              {
                "behavior": "effect_leaked"
              }
            ]
          }
        ]
      },
      {
        "name": "done"
      },
      {
        "name": "leaked"
      }
    ]
  },
  "instances": [
    {
      "id": "first"
    },
    {
      "id": "second"
    }
  ],
  "groups": [
    {
      "id": "both",
      "members": [
        "first",
        "second"
      ]
    }
  ],
  "behaviors": {
    "id_is_original": [
      {
        "op": "trace",
        "value": "guard:id-original"
      },
      {
        "op": "event_metadata_equals",
        "name": "id",
        "value": "evt-1"
      }
    ],
    "mutate_id": [
      {
        "op": "event_metadata_set",
        "name": "id",
        "value": "changed"
      },
      {
        "op": "trace",
        "value": "effect:isolated"
      }
    ],
    "effect_leaked": [
      {
        "op": "trace",
        "value": "effect:leaked"
      }
    ]
  },
  "script": [
    {
      "op": "start",
      "instance": "first"
    },
    {
      "op": "start",
      "instance": "second"
    },
    {
      "op": "group_dispatch",
      "group": "both",
      "event": {
        "name": "audit",
        "id": "evt-1",
        "source": "client",
        "target": "both"
      }
    },
    {
      "op": "dispatch_to",
      "targets": [
        "first",
        "second"
      ],
      "event": "release"
    }
  ],
  "expect": {
    "states": {
      "first": "/DeferEventIdentityFieldMutationIsolationAcrossGroupReplay/done",
      "second": "/DeferEventIdentityFieldMutationIsolationAcrossGroupReplay/done"
    },
    "trace": [
      {
        "type": "dispatch",
        "event": "audit",
        "target": "both"
      },
      {
        "type": "defer",
        "event": "audit"
      },
      {
        "type": "defer",
        "event": "audit"
      },
      {
        "type": "dispatch",
        "event": "release",
        "target": [
          "first",
          "second"
        ]
      },
      {
        "type": "undefer",
        "event": "audit"
      },
      {
        "type": "trace",
        "value": "guard:id-original"
      },
      {
        "type": "trace",
        "value": "effect:isolated"
      },
      {
        "type": "undefer",
        "event": "audit"
      },
      {
        "type": "trace",
        "value": "guard:id-original"
      },
      {
        "type": "trace",
        "value": "effect:isolated"
      },
      {
        "type": "stable",
        "state": "targets:first,second"
      }
    ]
  }
}
