                {
                  "behavior": "effect_wrong"
                }
              ]
            }
          ],
          "states": [
            {
              "name": "child",
              "entry": [
                {
                  "behavior": "entry_child"
                }
              ],
              "transitions": [
                {
                  "trigger": {
                    "kind": "on_set",
                    "attribute": "flag"
                  },
                  "target": "../flag_seen",
