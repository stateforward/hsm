{
  "version": "hsm-conformance-v1",
  "name": "config_queue_group_dispatch_mixed_started_stopped_filters_inactive_before_queue_hooks",
  "description": "Caller-originated group dispatch filters stopped members before queue hooks and enqueues regular events through active recipients' configured queues.",
  "features": ["queue", "group", "lifecycle", "stop"],
  "model": {
    "name": "ConfigQueueGroupDispatchMixedStartedStoppedFiltersInactiveBeforeQueueHooks",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "audit",
            "target": "done",
            "effects": [{"behavior": "effect_audit"}]
          }
        ]
      },
      {
        "name": "done",
        "entry": [{"behavior": "entry_done"}]
      }
    ]
  },
  "instances": [
    {"id": "worker_a", "config": {"queue": "trace_fifo"}},
    {"id": "worker_b", "config": {"queue": "trace_fifo"}},
    {"id": "stopped", "config": {"queue": "push_error"}}
  ],
  "groups": [
    {"id": "workers", "members": ["stopped", "worker_a", "worker_b"]}
  ],
  "behaviors": {
    "effect_audit": [{"op": "trace", "value": "effect:audit"}],
    "entry_done": [{"op": "trace", "value": "entry:done"}]
  },
  "script": [
    {"op": "start", "instance": "worker_a"},
    {"op": "start", "instance": "worker_b"},
    {"op": "start", "instance": "stopped"},
    {"op": "stop", "instance": "stopped"},
    {"op": "group_dispatch", "group": "workers", "event": "audit"}
  ],
  "expect": {
    "states": {
      "worker_a": "/ConfigQueueGroupDispatchMixedStartedStoppedFiltersInactiveBeforeQueueHooks/done",
      "worker_b": "/ConfigQueueGroupDispatchMixedStartedStoppedFiltersInactiveBeforeQueueHooks/done",
      "stopped": ""
    },
    "trace": [
      {"type": "dispatch", "event": "audit", "target": "workers"},
      {"type": "trace", "value": "queue:push:audit"},
      {"type": "trace", "value": "queue:pop:audit"},
      {"type": "trace", "value": "effect:audit"},
      {"type": "trace", "value": "entry:done"},
      {"type": "trace", "value": "queue:push:audit"},
      {"type": "trace", "value": "queue:pop:audit"},
      {"type": "trace", "value": "effect:audit"},
      {"type": "trace", "value": "entry:done"},
      {"type": "stable", "state": "group:workers"}
    ]
  }
}
