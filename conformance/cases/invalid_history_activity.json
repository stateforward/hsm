{
  "version": "hsm-conformance-v1",
  "name": "invalid_history_activity",
  "mode": "validation",
  "description": "History pseudostates must not declare activities.",
  "features": ["history", "activity", "validation"],
  "model": {
    "name": "InvalidHistoryActivity",
    "initial": "parent",
    "states": [
      {
        "name": "parent",
        "initial": "h",
        "states": [
          {
            "name": "h",
            "kind": "shallow_history",
            "activity": [
              {
                "behavior": "activity_h"
              }
            ],
            "transitions": [
              {
                "target": "idle"
              }
            ]
          },
          {
            "name": "idle"
          }
        ]
      }
    ]
  },
  "behaviors": {
    "activity_h": [
      {
        "op": "trace",
        "value": "activity:h"
      }
    ]
  },
  "expect": {
    "validation": [
      {
        "code": "invalid_pseudostate_contents"
      }
    ]
  }
}
