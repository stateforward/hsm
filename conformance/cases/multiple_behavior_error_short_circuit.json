{
  "version": "hsm-conformance-v1",
  "name": "multiple_behavior_error_short_circuit",
  "description": "A failing behavior reference in an ordered effects list prevents later effects and target entry from running.",
  "features": ["error", "effect", "selection_order"],
  "model": {
    "name": "MultipleBehaviorErrorShortCircuit",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "go",
            "target": "done",
            "effects": [
              {
                "behavior": "effect_before"
              },
              {
                "behavior": "effect_fail"
              },
              {
                "behavior": "effect_after"
              }
            ]
          }
        ]
      },
      {
        "name": "done",
        "entry": [
          {
            "behavior": "entry_done"
          }
        ]
      }
    ]
  },
  "behaviors": {
    "effect_before": [
      {
        "op": "trace",
        "value": "effect:before"
      }
    ],
    "effect_fail": [
      {
        "op": "trace",
        "value": "effect:fail"
      },
      {
        "op": "raise",
        "code": "behavior_error",
        "value": "boom"
      }
    ],
    "effect_after": [
      {
        "op": "trace",
        "value": "effect:after"
      }
    ],
    "entry_done": [
      {
        "op": "trace",
        "value": "entry:done"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "go"
    }
  ],
  "expect": {
    "error": {
      "code": "behavior_error",
      "message_contains": "boom"
    },
    "state": "/MultipleBehaviorErrorShortCircuit/idle",
    "trace": [
      {
        "type": "dispatch",
        "event": "go"
      },
      {
        "type": "trace",
        "value": "effect:before"
      },
      {
        "type": "trace",
        "value": "effect:fail"
      },
      {
        "type": "error",
        "code": "behavior_error"
      },
      {
        "type": "stable",
        "state": "/MultipleBehaviorErrorShortCircuit/idle"
      }
    ]
  }
}
