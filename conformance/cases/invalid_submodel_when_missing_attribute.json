{
  "version": "hsm-conformance-v1",
  "name": "invalid_submodel_when_missing_attribute",
  "mode": "validation",
  "description": "when attribute references inside child models must be validated recursively.",
  "features": ["submachine", "attribute", "when", "validation"],
  "model": {
    "name": "InvalidSubmodelWhenMissingAttribute",
    "initial": "drive",
    "states": [
      {
        "name": "drive",
        "kind": "submachine",
        "machine": "ChildWithMissingWhenAttribute"
      }
    ]
  },
  "models": [
    {
      "name": "ChildWithMissingWhenAttribute",
      "initial": "idle",
      "states": [
        {
          "name": "idle",
          "transitions": [
            {
              "trigger": {
                "kind": "when",
                "attribute": "missing"
              },
              "target": "done"
            }
          ]
        },
        {
          "name": "done"
        }
      ]
    }
  ],
  "expect": {
    "validation": [
      {
        "code": "missing_attribute"
      }
    ]
  }
}
