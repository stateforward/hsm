{
  "version": "hsm-conformance-v1",
  "name": "submachine_restart_resets_child",
  "description": "Restarting a machine while inside a submachine resets the child to its default entry state.",
  "features": [
    "submachine",
    "lifecycle",
    "restart"
  ],
  "model": {
    "name": "SubmachineRestart",
    "initial": "drive",
    "states": [
      {
        "name": "drive",
        "kind": "submachine",
        "machine": "RestartChild"
      }
    ]
  },
  "models": [
    {
      "name": "RestartChild",
      "initial": "a",
      "states": [
        {
          "name": "a",
          "entry": [
            {
              "behavior": "entry_a"
            }
          ],
          "transitions": [
            {
              "on": "flip",
              "target": "b"
            }
          ]
        },
        {
          "name": "b",
          "entry": [
            {
              "behavior": "entry_b"
            }
          ]
        }
      ]
    }
  ],
  "behaviors": {
    "entry_a": [
      {
        "op": "trace",
        "value": "enter:a"
      }
    ],
    "entry_b": [
      {
        "op": "trace",
        "value": "enter:b"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "flip"
    },
    {
      "op": "restart"
    }
  ],
  "expect": {
    "state": "/SubmachineRestart/drive/a",
    "trace": [
      {
        "type": "trace",
        "value": "enter:a"
      },
      {
        "type": "dispatch",
        "event": "flip"
      },
      {
        "type": "trace",
        "value": "enter:b"
      },
      {
        "type": "trace",
        "value": "enter:a"
      },
      {
        "type": "stable",
        "state": "/SubmachineRestart/drive/a"
      }
    ]
  }
}
