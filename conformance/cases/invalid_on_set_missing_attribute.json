{
  "version": "hsm-conformance-v1",
  "name": "invalid_on_set_missing_attribute",
  "mode": "validation",
  "description": "An on_set trigger must reference a declared model attribute.",
  "features": [
    "attribute",
    "on_set",
    "validation"
  ],
  "model": {
    "name": "InvalidOnSetMissingAttribute",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "trigger": {
              "kind": "on_set",
              "attribute": "missing"
            },
            "target": "done"
          }
        ]
      },
      {
        "name": "done"
      }
    ]
  },
  "expect": {
    "validation": [
      {
        "code": "missing_attribute"
      }
    ]
  }
}
