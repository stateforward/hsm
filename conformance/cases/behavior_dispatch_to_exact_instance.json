{
  "version": "hsm-conformance-v1",
  "name": "behavior_dispatch_to_exact_instance",
  "description": "A behavior dispatch op can target one named instance without delivering to the current instance.",
  "features": ["dispatch_to", "event_ownership", "queue", "reentrancy"],
  "model": {
    "name": "BehaviorDispatchToExactProducer",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "go",
            "target": "sent",
            "effects": [{"behavior": "dispatch_peer"}]
          },
          {
            "on": "audit",
            "target": "self_leaked",
            "effects": [{"behavior": "effect_self_leaked"}]
          }
        ]
      },
      {"name": "sent", "entry": [{"behavior": "entry_sent"}]},
      {"name": "self_leaked"}
    ]
  },
  "models": [
    {
      "name": "BehaviorDispatchToExactPeer",
      "initial": "peer_idle",
      "states": [
        {
          "name": "peer_idle",
          "transitions": [
            {
              "on": "audit",
              "target": "peer_done",
              "effects": [{"behavior": "effect_peer"}]
            }
          ]
        },
        {"name": "peer_done", "entry": [{"behavior": "entry_peer_done"}]}
      ]
    }
  ],
  "instances": [
    {"id": "producer"},
    {"id": "peer", "model": "BehaviorDispatchToExactPeer"}
  ],
  "behaviors": {
    "dispatch_peer": [{"op": "dispatch", "event": "audit", "target": "peer"}, {"op": "trace", "value": "effect:dispatch-peer"}],
    "entry_sent": [{"op": "trace", "value": "entry:sent"}],
    "effect_peer": [{"op": "trace", "value": "effect:peer"}],
    "entry_peer_done": [{"op": "trace", "value": "entry:peer-done"}],
    "effect_self_leaked": [{"op": "trace", "value": "effect:self-leaked"}]
  },
  "script": [
    {"op": "start", "instance": "producer"},
    {"op": "start", "instance": "peer"},
    {"op": "dispatch_to", "target": "producer", "event": "go"}
  ],
  "expect": {
    "states": {
      "producer": "/BehaviorDispatchToExactProducer/sent",
      "peer": "/BehaviorDispatchToExactPeer/peer_done"
    },
    "trace": [
      {"type": "dispatch", "event": "go", "target": "producer"},
      {"type": "dispatch", "event": "audit", "target": "peer"},
      {"type": "trace", "value": "effect:peer"},
      {"type": "trace", "value": "entry:peer-done"},
      {"type": "trace", "value": "effect:dispatch-peer"},
      {"type": "trace", "value": "entry:sent"},
      {"type": "stable", "state": "producer"}
    ]
  }
}
