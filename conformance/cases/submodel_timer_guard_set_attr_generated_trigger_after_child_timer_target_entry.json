{
  "version": "hsm-conformance-v1",
  "name": "submodel_timer_guard_set_attr_generated_trigger_after_child_timer_target_entry",
  "description": "Attribute work from a child-model timer transition guard replays only after the child target reaches its nested leaf.",
  "features": [
    "submachine",
    "timer",
    "after",
    "attribute",
    "on_set",
    "when",
    "guard",
    "nested",
    "queue",
    "reentrancy"
  ],
  "model": {
