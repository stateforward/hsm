{
  "version": "hsm-conformance-v1",
  "name": "timer_at_attribute_capture",
  "description": "An at timer using an attribute timepoint captures its deadline on state entry and is not rescheduled by later attribute changes.",
  "features": [
    "timer",
    "at",
    "attribute"
  ],
  "model": {
    "name": "TimerAtAttribute",
    "initial": "waiting",
    "attributes": {
      "deadline_ms": {
        "type": "time_ms",
        "default": 50
      }
    },
    "states": [
      {
        "name": "waiting",
        "transitions": [
          {
            "trigger": {
              "kind": "at",
              "attribute": "deadline_ms"
            },
            "target": "fired",
            "effects": [
              {
                "behavior": "effect_timer"
              }
            ]
          }
        ]
      },
      {
        "name": "fired",
        "entry": [
          {
            "behavior": "entry_fired"
          }
        ]
      }
    ]
  },
  "behaviors": {
    "effect_timer": [
      {
        "op": "trace",
        "value": "effect:timer"
      }
    ],
    "entry_fired": [
      {
        "op": "trace",
        "value": "enter:fired"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "set",
      "attribute": "deadline_ms",
      "value": 1000
    },
    {
      "op": "tick",
      "millis": 50
    }
  ],
  "expect": {
    "state": "/TimerAtAttribute/fired",
    "attributes": {
      "deadline_ms": 1000
    },
    "trace": [
      {
        "type": "timer_scheduled"
      },
      {
        "type": "set",
        "attribute": "deadline_ms",
        "value": 1000
      },
      {
        "type": "timer_fired"
      },
      {
        "type": "trace",
        "value": "effect:timer"
      },
      {
        "type": "trace",
        "value": "enter:fired"
      },
      {
        "type": "stable",
        "state": "/TimerAtAttribute/fired"
      }
    ]
  }
}
