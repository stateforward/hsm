{
  "version": "hsm-conformance-v1",
  "name": "defer_replay_after_deferring_state_exit",
  "description": "A deferred event replays only after the deferring state has exited and the transition target is entered.",
  "features": [
    "defer",
    "queue",
    "exit",
    "entry"
  ],
  "model": {
    "name": "DeferReplayAfterDeferringStateExit",
    "initial": "blocked",
    "states": [
      {
        "name": "blocked",
        "defer": [
          "work"
        ],
        "exit": [
          {
            "behavior": "exit_blocked"
          }
        ],
        "transitions": [
          {
            "on": "release",
            "target": "ready",
            "effects": [
              {
                "behavior": "effect_release"
              }
            ]
          }
        ]
      },
      {
        "name": "ready",
        "entry": [
          {
            "behavior": "entry_ready"
          }
        ],
        "transitions": [
          {
            "on": "work",
            "target": "done",
            "effects": [
              {
                "behavior": "effect_work"
              }
            ]
          }
        ]
      },
      {
        "name": "done",
        "entry": [
          {
            "behavior": "entry_done"
          }
        ]
      }
    ]
  },
  "behaviors": {
    "exit_blocked": [
      {
        "op": "trace",
        "value": "exit:blocked"
      }
    ],
    "effect_release": [
      {
        "op": "trace",
        "value": "effect:release"
      }
    ],
    "entry_ready": [
      {
        "op": "trace",
        "value": "enter:ready"
      }
    ],
    "effect_work": [
      {
        "op": "trace",
        "value": "effect:work"
      }
    ],
    "entry_done": [
      {
        "op": "trace",
        "value": "enter:done"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "work"
    },
    {
      "op": "dispatch",
      "event": "release"
    }
  ],
  "expect": {
    "state": "/DeferReplayAfterDeferringStateExit/done",
    "queue": {
      "deferred": [
        "work"
      ],
      "replay": "after_deferring_state_exit"
    },
    "trace": [
      {
        "type": "dispatch",
        "event": "work"
      },
      {
        "type": "defer",
        "event": "work"
      },
      {
        "type": "dispatch",
        "event": "release"
      },
      {
        "type": "undefer",
        "event": "work"
      },
      {
        "type": "trace",
        "value": "exit:blocked"
      },
      {
        "type": "trace",
        "value": "effect:release"
      },
      {
        "type": "trace",
        "value": "enter:ready"
      },
      {
        "type": "trace",
        "value": "effect:work"
      },
      {
        "type": "trace",
        "value": "enter:done"
      },
      {
        "type": "stable",
        "state": "/DeferReplayAfterDeferringStateExit/done"
      }
    ]
  }
}
