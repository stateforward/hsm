{
  "version": "hsm-conformance-v1",
  "name": "defer_behavior_dispatch_event_source_target_field_mutation_isolation_across_group_replay",
  "description": "A behavior-dispatched event object deferred by multiple group recipients preserves route-adjacent source and target field isolation when each recipient later replays it.",
  "features": ["defer", "event_ownership", "group", "queue", "reentrancy"],
  "model": {
    "name": "DeferBehaviorDispatchEventSourceTargetFieldMutationIsolationAcrossGroupReplay",
    "initial": "hold",
    "states": [
      {
        "name": "hold",
        "defer": ["audit"],
        "transitions": [
          {"on": "go", "effects": [{"behavior": "dispatch_audit"}]},
          {"on": "release", "target": "ready"}
        ]
      },
      {
        "name": "ready",
        "transitions": [
          {"on": "audit", "guard": {"behavior": "source_and_target_original"}, "target": "done", "effects": [{"behavior": "mutate_source_target"}]},
          {"on": "audit", "target": "leaked", "effects": [{"behavior": "effect_leaked"}]}
        ]
      },
      {"name": "done"},
      {"name": "leaked"}
    ]
  },
  "instances": [{"id": "producer"}, {"id": "peer"}],
  "groups": [{"id": "both", "members": ["producer", "peer"]}],
  "behaviors": {
    "dispatch_audit": [{"op": "dispatch", "group": "both", "event": {"name": "audit", "id": "evt-1", "source": "declared-source", "target": "declared-target"}}],
    "source_and_target_original": [
      {"op": "trace", "value": "guard:source-target-original"},
      {"op": "event_metadata_equals", "name": "source", "value": "declared-source"},
      {"op": "event_metadata_equals", "name": "target", "value": "declared-target"}
    ],
    "mutate_source_target": [
      {"op": "event_metadata_set", "name": "source", "value": "changed-source"},
      {"op": "event_metadata_set", "name": "target", "value": "changed-target"},
      {"op": "trace", "value": "effect:isolated"}
    ],
    "effect_leaked": [{"op": "trace", "value": "effect:leaked"}]
  },
  "script": [
    {"op": "start", "instance": "producer"},
    {"op": "start", "instance": "peer"},
    {"op": "dispatch_to", "target": "producer", "event": "go"},
    {"op": "dispatch_to", "targets": ["producer", "peer"], "event": "release"}
  ],
  "expect": {
    "states": {
      "producer": "/DeferBehaviorDispatchEventSourceTargetFieldMutationIsolationAcrossGroupReplay/done",
      "peer": "/DeferBehaviorDispatchEventSourceTargetFieldMutationIsolationAcrossGroupReplay/done"
    },
    "trace": [
      {"type": "dispatch", "event": "go", "target": "producer"},
      {"type": "dispatch", "event": "audit", "target": "both"},
      {"type": "defer", "event": "audit"},
      {"type": "defer", "event": "audit"},
      {"type": "dispatch", "event": "release", "target": ["producer", "peer"]},
      {"type": "undefer", "event": "audit"},
      {"type": "trace", "value": "guard:source-target-original"},
      {"type": "trace", "value": "effect:isolated"},
      {"type": "undefer", "event": "audit"},
      {"type": "trace", "value": "guard:source-target-original"},
      {"type": "trace", "value": "effect:isolated"},
      {"type": "stable", "state": "targets:producer,peer"}
    ]
  }
}
