{
  "version": "hsm-conformance-v1",
  "name": "behavior_dispatch_event_name_mutation_isolation_broadcast",
  "description": "Mutating the event name in one recipient of a behavior-originated broadcast remains recipient-local and does not affect sibling recipient routing.",
  "features": [
    "event_ownership",
    "broadcast",
    "queue",
    "reentrancy",
    "guard"
  ],
  "model": {
    "name": "BehaviorDispatchEventNameMutationIsolationBroadcast",
    "initial": "listening",
    "states": [
      {
        "name": "listening",
        "transitions": [
          {
            "on": "go",
            "effects": [
              {
                "behavior": "dispatch_mutate"
              }
            ]
          },
          {
            "on": "mutate",
            "guard": {
              "behavior": "name_is_mutate"
            },
            "target": "done",
            "effects": [
              {
                "behavior": "rename_event"
              }
            ]
          },
          {
            "on": "changed",
            "target": "leaked",
            "effects": [
              {
                "behavior": "effect_leaked"
              }
            ]
          }
        ]
      },
      {
        "name": "done"
      },
      {
        "name": "leaked"
      }
    ]
  },
  "instances": [
    {
      "id": "producer"
    },
    {
      "id": "peer"
    }
  ],
  "behaviors": {
    "dispatch_mutate": [
      {
        "op": "dispatch",
        "target": "all",
        "event": "mutate"
      }
    ],
    "name_is_mutate": [
      {
        "op": "trace",
        "value": "guard:name-mutate"
      },
      {
        "op": "event_name_equals",
        "value": "mutate"
      }
    ],
    "rename_event": [
      {
        "op": "event_metadata_set",
        "name": "name",
        "value": "changed"
      },
      {
        "op": "trace",
        "value": "effect:renamed"
      }
    ],
    "effect_leaked": [
      {
        "op": "trace",
        "value": "effect:leaked"
      }
    ]
  },
  "script": [
    {
      "op": "start",
      "instance": "producer"
    },
    {
      "op": "start",
      "instance": "peer"
    },
    {
      "op": "dispatch_to",
      "target": "producer",
      "event": "go"
    }
  ],
  "expect": {
    "states": {
      "producer": "/BehaviorDispatchEventNameMutationIsolationBroadcast/done",
      "peer": "/BehaviorDispatchEventNameMutationIsolationBroadcast/done"
    },
    "trace": [
      {
        "type": "dispatch",
        "event": "go",
        "target": "producer"
      },
      {
        "type": "dispatch",
        "event": "mutate",
        "target": "all"
      },
      {
        "type": "trace",
        "value": "guard:name-mutate"
      },
      {
        "type": "trace",
        "value": "effect:renamed"
      },
      {
        "type": "trace",
        "value": "guard:name-mutate"
      },
      {
        "type": "trace",
        "value": "effect:renamed"
      },
      {
        "type": "stable",
        "state": "producer"
      }
    ]
  }
}
