{
  "version": "hsm-conformance-v1",
  "name": "event_name_set_false_guard_visible_to_fallback_guard",
  "description": "An event name write by a false guard is ignored by later guards during the same event selection pass.",
  "features": ["event_ownership", "guard", "selection_order"],
  "model": {
    "name": "EventNameSetFalseGuardVisibleToFallbackGuard",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "go",
            "guard": {"behavior": "rename_then_false"},
            "target": "wrong"
          },
          {
            "on": "go",
            "guard": {"behavior": "renamed_by_prior_guard"},
            "target": "done",
            "effects": [{"behavior": "effect_done"}]
          },
          {
            "on": "go",
            "target": "fallback",
            "effects": [{"behavior": "effect_fallback"}]
          }
        ]
      },
      {"name": "wrong"},
      {"name": "done"},
      {"name": "fallback"}
    ]
  },
  "behaviors": {
    "rename_then_false": [
      {"op": "event_metadata_set", "name": "name", "value": "renamed"},
      {"op": "trace", "value": "guard:rename"},
      {"op": "return_value", "value": false}
    ],
    "renamed_by_prior_guard": [
      {"op": "trace", "value": "guard:renamed"},
      {"op": "event_name_equals", "value": "renamed"}
    ],
    "effect_done": [{"op": "trace", "value": "effect:done"}],
    "effect_fallback": [{"op": "trace", "value": "effect:fallback"}]
  },
  "script": [
    {"op": "start"},
    {"op": "dispatch", "event": "go"}
  ],
  "expect": {
    "state": "/EventNameSetFalseGuardVisibleToFallbackGuard/fallback",
    "trace": [
      {"type": "dispatch", "event": "go"},
      {"type": "trace", "value": "guard:rename"},
      {"type": "trace", "value": "guard:renamed"},
      {"type": "trace", "value": "effect:fallback"},
      {"type": "stable", "state": "/EventNameSetFalseGuardVisibleToFallbackGuard/fallback"}
    ]
  }
}
