{
  "version": "hsm-conformance-v1",
  "name": "invalid_timer_multiple_sources",
  "mode": "validation",
  "description": "A timer trigger must not declare multiple competing time sources.",
  "features": [
    "timer",
    "validation"
  ],
  "model": {
    "name": "InvalidTimerMultipleSources",
    "initial": "waiting",
    "attributes": {
      "delay_ms": {
        "type": "duration_ms",
        "default": 10
      }
    },
    "states": [
      {
        "name": "waiting",
        "transitions": [
          {
            "trigger": {
              "kind": "after",
              "duration_ms": 10,
              "attribute": "delay_ms"
            },
            "target": "done"
          }
        ]
      },
      {
        "name": "done"
      }
    ]
  },
  "expect": {
    "validation": [
      {
        "code": "invalid_timer_source"
      }
    ]
  }
}
