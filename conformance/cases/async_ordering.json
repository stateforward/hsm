{
  "version": "hsm-conformance-v1",
  "name": "async_ordering",
  "features": [
    "async"
  ],
  "model": {
    "name": "AsyncOrdering",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "go",
            "target": "done",
            "effects": [
              {
                "behavior": "async_effect"
              }
            ]
          }
        ]
      },
      {
        "name": "done",
        "entry": [
          {
            "behavior": "entry_done"
          }
        ]
      }
    ]
  },
  "behaviors": {
    "async_effect": [
      {
        "op": "trace",
        "value": "async:before"
      },
      {
        "op": "yield"
      },
      {
        "op": "trace",
        "value": "async:after"
      }
    ],
    "entry_done": [
      {
        "op": "trace",
        "value": "enter:done"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "go"
    }
  ],
  "expect": {
    "state": "/AsyncOrdering/done",
    "trace": [
      {
        "type": "dispatch",
        "event": "go"
      },
      {
        "type": "trace",
        "value": "async:before"
      },
      {
        "type": "trace",
        "value": "async:after"
      },
      {
        "type": "trace",
        "value": "enter:done"
      },
      {
        "type": "stable",
        "state": "/AsyncOrdering/done"
      }
    ]
  }
}
