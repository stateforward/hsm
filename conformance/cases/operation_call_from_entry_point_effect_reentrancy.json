{
  "version": "hsm-conformance-v1",
  "name": "operation_call_from_entry_point_effect_reentrancy",
  "description": "An operation called from an entry-point effect queues its on_call event until the submachine target is entered.",
  "features": [
    "operation",
    "on_call",
    "submachine",
    "entry_point",
    "queue",
    "reentrancy"
  ],
  "model": {
    "name": "OperationCallFromEntryPointEffectReentrancy",
    "initial": "outside",
    "operations": {
      "audit": {
        "behavior": "operation_audit"
      }
    },
    "states": [
      {
        "name": "outside",
        "transitions": [
          {
            "on": "go",
            "target": "drive",
            "entry_point": "warm"
          }
        ]
      },
      {
        "name": "drive",
        "kind": "submachine",
        "machine": "CallFromEntryPointChild"
      }
    ]
  },
  "models": [
    {
      "name": "CallFromEntryPointChild",
      "initial": "cold",
      "operations": {
        "audit": {
          "behavior": "operation_audit"
        }
      },
      "entry_points": [
        {
          "name": "warm",
          "target": "running",
          "effects": [
            {
              "behavior": "entry_point_calls_audit"
            }
          ]
        }
      ],
      "states": [
        {
          "name": "cold"
        },
        {
          "name": "running",
          "entry": [
            {
              "behavior": "entry_running"
            }
          ],
          "transitions": [
            {
              "trigger": {
                "kind": "on_call",
                "operation": "audit"
              },
              "target": "handled",
              "effects": [
                {
                  "behavior": "effect_audit"
                }
              ]
            }
          ]
        },
        {
          "name": "handled",
          "entry": [
            {
              "behavior": "entry_handled"
            }
          ]
        }
      ]
    }
  ],
  "behaviors": {
    "operation_audit": [
      {
        "op": "trace",
        "value": "operation:audit"
      }
    ],
    "entry_point_calls_audit": [
      {
        "op": "trace",
        "value": "entry-point:before-call"
      },
      {
        "op": "call",
        "name": "audit"
      },
      {
        "op": "trace",
        "value": "entry-point:after-call"
      }
    ],
    "entry_running": [
      {
        "op": "trace",
        "value": "entry:running"
      }
    ],
    "effect_audit": [
      {
        "op": "trace",
        "value": "effect:audit"
      }
    ],
    "entry_handled": [
      {
        "op": "trace",
        "value": "entry:handled"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "go"
    }
  ],
  "expect": {
    "state": "/OperationCallFromEntryPointEffectReentrancy/drive/handled",
    "queue": {
      "operation_call_from_entry_point_effect": "queued_until_entry_point_target_entry_completes"
    },
    "trace": [
      {
        "type": "dispatch",
        "event": "go"
      },
      {
        "type": "trace",
        "value": "entry-point:before-call"
      },
      {
        "type": "trace",
        "value": "operation:audit"
      },
      {
        "type": "trace",
        "value": "entry-point:after-call"
      },
      {
        "type": "trace",
        "value": "entry:running"
      },
      {
        "type": "trace",
        "value": "effect:audit"
      },
      {
        "type": "trace",
        "value": "entry:handled"
      },
      {
        "type": "stable",
        "state": "/OperationCallFromEntryPointEffectReentrancy/drive/handled"
      }
    ]
  }
}
