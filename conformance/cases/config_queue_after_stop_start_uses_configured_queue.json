{
  "version": "hsm-conformance-v1",
  "name": "config_queue_after_stop_start_uses_configured_queue",
  "description": "An instance that was stopped and started again continues to route subsequent regular events through its configured queue.",
  "features": ["queue", "lifecycle", "stop", "dispatch_to"],
  "model": {
    "name": "ConfigQueueAfterStopStartUsesConfiguredQueue",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "go",
            "target": "done",
            "effects": [
              {
                "behavior": "effect_go"
              }
            ]
          }
        ]
      },
      {
        "name": "done"
      }
    ]
  },
  "instances": [
    {
      "id": "queued",
      "config": {
        "queue": "trace_fifo"
      }
    }
  ],
  "behaviors": {
    "effect_go": [
      {
        "op": "trace",
        "value": "effect:go"
      }
    ]
  },
  "script": [
    {
      "op": "start",
      "instance": "queued"
    },
    {
      "op": "stop",
      "instance": "queued"
    },
    {
      "op": "start",
      "instance": "queued"
    },
    {
      "op": "dispatch_to",
      "target": "queued",
      "event": "go"
    }
  ],
  "expect": {
    "states": {
      "queued": "/ConfigQueueAfterStopStartUsesConfiguredQueue/done"
    },
    "trace": [
      {
        "type": "dispatch",
        "event": "go",
        "target": "queued"
      },
      {
        "type": "trace",
        "value": "queue:push:go"
      },
      {
        "type": "trace",
        "value": "queue:pop:go"
      },
      {
        "type": "trace",
        "value": "effect:go"
      },
      {
        "type": "stable",
        "state": "queued"
      }
    ]
  }
}
