{
  "version": "hsm-conformance-v1",
  "name": "config_clock_trace_after",
  "description": "An instance config clock hook is used by after timers instead of the default clock.",
  "features": ["timer", "after"],
  "model": {
    "name": "ConfigClockTraceAfter",
    "initial": "waiting",
    "states": [
      {
        "name": "waiting",
        "transitions": [
          {
            "trigger": {
              "kind": "after",
              "duration_ms": 25
            },
            "target": "fired",
            "effects": [
              {
                "behavior": "effect_timer"
              }
            ]
          }
        ]
      },
      {
        "name": "fired"
      }
    ]
  },
  "instances": [
    {
      "id": "default",
      "config": {
        "clock": "trace_no_sleep"
      }
    }
  ],
  "behaviors": {
    "effect_timer": [
      {
        "op": "trace",
        "value": "effect:timer"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "tick",
      "millis": 0
    }
  ],
  "expect": {
    "state": "/ConfigClockTraceAfter/fired",
    "trace": [
      {
        "type": "timer_scheduled"
      },
      {
        "type": "trace",
        "value": "clock:sleep:25"
      },
      {
        "type": "timer_fired"
      },
      {
        "type": "trace",
        "value": "effect:timer"
      },
      {
        "type": "stable",
        "state": "/ConfigClockTraceAfter/fired"
      }
    ]
  }
}
