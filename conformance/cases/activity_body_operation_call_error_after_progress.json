{"version":"hsm-conformance-v1","name":"activity_body_operation_call_error_after_progress","description":"An async activity that fails through a called operation after yielding reports the operation error, skips later activity ops, and leaves the activity state active.","features":["activity","async","operation","error"],"model":{"name":"ActivityBodyOperationCallErrorAfterProgress","initial":"active","operations":{"fail":{"behavior":"operation_fail"}},"states":[{"name":"active","activity":[{"behavior":"activity_calls_fail"}]}]},"behaviors":{"activity_calls_fail":[{"op":"trace","value":"activity:start"},{"op":"yield"},{"op":"trace","value":"activity:progress"},{"op":"call","name":"fail"},{"op":"trace","value":"activity:after-call"}],"operation_fail":[{"op":"trace","value":"operation:fail"},{"op":"raise","code":"operation_error","value":"activity operation boom"}]},"script":[{"op":"start"},{"op":"sleep","millis":0}],"expect":{"state":"/ActivityBodyOperationCallErrorAfterProgress/active","error":{"code":"operation_error","message_contains":"activity operation boom"},"trace":[{"type":"trace","value":"activity:start"},{"type":"trace","value":"activity:progress"},{"type":"trace","value":"operation:fail"},{"type":"error","code":"operation_error"},{"type":"stable","state":"/ActivityBodyOperationCallErrorAfterProgress/active"}]}}
