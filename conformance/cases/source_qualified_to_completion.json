{
  "version": "hsm-conformance-v1",
  "name": "source_qualified_to_completion",
  "description": "A source-qualified parent transition can target a nested final state and immediately trigger parent completion.",
  "features": [
    "source",
    "completion",
    "final",
    "nested"
  ],
  "model": {
    "name": "SourceToCompletion",
    "initial": "parent",
    "states": [
      {
        "name": "parent",
        "initial": "work",
        "transitions": [
          {
            "source": "parent/work",
            "on": "finish",
            "target": "parent/done",
            "effects": [
              {
                "behavior": "effect_finish"
              }
            ]
          },
          {
            "trigger": {
              "kind": "completion"
            },
            "target": "complete",
            "effects": [
              {
                "behavior": "effect_complete"
              }
            ]
          }
        ],
        "states": [
          {
            "name": "work"
          },
          {
            "name": "done",
            "kind": "final"
          }
        ]
      },
      {
        "name": "complete",
        "entry": [
          {
            "behavior": "entry_complete"
          }
        ]
      }
    ]
  },
  "behaviors": {
    "effect_finish": [
      {
        "op": "trace",
        "value": "effect:finish"
      }
    ],
    "effect_complete": [
      {
        "op": "trace",
        "value": "effect:complete"
      }
    ],
    "entry_complete": [
      {
        "op": "trace",
        "value": "enter:complete"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "finish"
    }
  ],
  "expect": {
    "state": "/SourceToCompletion/complete",
    "trace": [
      {
        "type": "dispatch",
        "event": "finish"
      },
      {
        "type": "trace",
        "value": "effect:finish"
      },
      {
        "type": "trace",
        "value": "effect:complete"
      },
      {
        "type": "trace",
        "value": "enter:complete"
      },
      {
        "type": "stable",
        "state": "/SourceToCompletion/complete"
      }
    ]
  }
}
