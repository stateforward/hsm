{
  "version": "hsm-conformance-v1",
  "name": "submachine_exit_point_ignores_child_state_exit_point_declared_first",
  "description": "A parent exit-point handler on a submachine state attaches to the composed machine's own exit point even when a direct child state's same-named exit point is declared first: the composed machine redefines a base whose child submachine state is replayed before the derived model adds its own exit point.",
  "features": [
    "submachine",
    "exit_point",
    "nested",
    "redefine"
  ],
  "model": {
    "name": "SubmachineExitCaptureDeclaredFirst",
    "initial": "drive",
    "states": [
      {
        "name": "drive",
        "kind": "submachine",
        "machine": "ExitCaptureDeclaredFirstChild",
        "transitions": [
          {
            "trigger": {
              "kind": "exit_point",
              "exit_point": "ok"
            },
            "target": "complete",
            "effects": [
              {
                "behavior": "effect_host_ok"
              }
            ]
          }
        ]
      },
      {
        "name": "complete",
        "entry": [
          {
            "behavior": "entry_complete"
          }
        ]
      }
    ]
  },
  "models": [
    {
      "name": "ExitCaptureDeclaredFirstChildBase",
      "initial": "community",
      "states": [
        {
          "name": "community",
          "kind": "submachine",
          "machine": "ExitCaptureDeclaredFirstInner"
        }
      ]
    },
    {
      "name": "ExitCaptureDeclaredFirstChild",
      "redefines": "ExitCaptureDeclaredFirstChildBase",
      "exit_points": [
        {
          "name": "ok"
        }
      ],
      "transitions": [
        {
          "source": "community",
          "trigger": {
            "kind": "exit_point",
            "exit_point": "ok"
          },
          "target": "ok",
          "effects": [
            {
              "behavior": "effect_child_ok"
            }
          ]
        }
      ]
    },
    {
      "name": "ExitCaptureDeclaredFirstInner",
      "initial": "idle",
      "exit_points": [
        {
          "name": "ok"
        }
      ],
      "states": [
        {
          "name": "idle",
          "transitions": [
            {
              "on": "finish",
              "target": "../ok",
              "effects": [
                {
                  "behavior": "effect_inner_finish"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "behaviors": {
    "effect_inner_finish": [
      {
        "op": "trace",
        "value": "effect:inner-finish"
      }
    ],
    "effect_child_ok": [
      {
        "op": "trace",
        "value": "effect:child-ok"
      }
    ],
    "effect_host_ok": [
      {
        "op": "trace",
        "value": "effect:host-ok"
      }
    ],
    "entry_complete": [
      {
        "op": "trace",
        "value": "enter:complete"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "finish"
    }
  ],
  "expect": {
    "state": "/SubmachineExitCaptureDeclaredFirst/complete",
    "trace": [
      {
        "type": "dispatch",
        "event": "finish"
      },
      {
        "type": "trace",
        "value": "effect:inner-finish"
      },
      {
        "type": "trace",
        "value": "effect:child-ok"
      },
      {
        "type": "trace",
        "value": "effect:host-ok"
      },
      {
        "type": "trace",
        "value": "enter:complete"
      },
      {
        "type": "stable",
        "state": "/SubmachineExitCaptureDeclaredFirst/complete"
      }
    ]
  }
}
