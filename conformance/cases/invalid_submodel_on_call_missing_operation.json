{
  "version": "hsm-conformance-v1",
  "name": "invalid_submodel_on_call_missing_operation",
  "mode": "validation",
  "description": "on_call triggers inside child models must validate operation references recursively.",
  "features": ["submachine", "operation", "on_call", "validation"],
  "model": {
    "name": "InvalidSubmodelOnCallMissingOperation",
    "initial": "drive",
    "states": [
      {
        "name": "drive",
        "kind": "submachine",
        "machine": "ChildWithMissingOnCallOperation"
      }
    ]
  },
  "models": [
    {
      "name": "ChildWithMissingOnCallOperation",
      "initial": "idle",
      "states": [
        {
          "name": "idle",
          "transitions": [
            {
              "trigger": {
                "kind": "on_call",
                "operation": "missing"
              },
              "target": "done"
            }
          ]
        },
        {
          "name": "done"
        }
      ]
    }
  ],
  "expect": {
    "validation": [
      {
        "code": "missing_operation"
      }
    ]
  }
}
