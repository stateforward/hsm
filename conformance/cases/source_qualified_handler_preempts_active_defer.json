{
  "version": "hsm-conformance-v1",
  "name": "source_qualified_handler_preempts_active_defer",
  "description": "A source-qualified transition whose source is the active deferring state consumes the event instead of deferring it.",
  "features": [
    "source",
    "defer"
  ],
  "model": {
    "name": "SourceQualifiedHandlerPreemptsActiveDefer",
    "initial": "blocked",
    "states": [
      {
        "name": "blocked",
        "defer": [
          "work"
        ]
      },
      {
        "name": "done",
        "entry": [
          {
            "behavior": "entry_done"
          }
        ]
      }
    ],
    "transitions": [
      {
        "source": "blocked",
        "on": "work",
        "target": "done",
        "effects": [
          {
            "behavior": "effect_work"
          }
        ]
      }
    ]
  },
  "behaviors": {
    "effect_work": [
      {
        "op": "trace",
        "value": "effect:work"
      }
    ],
    "entry_done": [
      {
        "op": "trace",
        "value": "entry:done"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "work"
    }
  ],
  "expect": {
    "state": "/SourceQualifiedHandlerPreemptsActiveDefer/done",
    "trace": [
      {
        "type": "dispatch",
        "event": "work"
      },
      {
        "type": "trace",
        "value": "effect:work"
      },
      {
        "type": "trace",
        "value": "entry:done"
      },
      {
        "type": "stable",
        "state": "/SourceQualifiedHandlerPreemptsActiveDefer/done"
      }
    ]
  }
}
