{
  "version": "hsm-conformance-v1",
  "name": "root_transition_effect_call_reentrancy",
  "description": "A behavior-side operation call from a root-owned transition effect queues its on_call event behind the global transition.",
  "features": ["operation", "on_call", "root_transition", "queue", "reentrancy"],
  "model": {
    "name": "RootTransitionEffectCallReentrancy",
    "initial": "idle",
    "operations": {"audit": {"behavior": "operation_audit"}},
    "states": [
      {"name": "idle", "exit": [{"behavior": "exit_idle"}]},
      {
        "name": "waiting",
        "entry": [{"behavior": "entry_waiting"}],
        "transitions": [
          {
            "trigger": {"kind": "on_call", "operation": "audit"},
            "target": "done",
            "effects": [{"behavior": "effect_audit"}]
          }
        ]
      },
      {"name": "done"}
    ],
    "transitions": [
      {"on": "go", "target": "waiting", "effects": [{"behavior": "effect_call"}]}
    ]
  },
  "behaviors": {
    "operation_audit": [{"op": "trace", "value": "operation:audit"}],
    "exit_idle": [{"op": "trace", "value": "exit:idle"}],
    "effect_call": [
      {"op": "call", "name": "audit"},
      {"op": "trace", "value": "effect:go"}
    ],
    "entry_waiting": [{"op": "trace", "value": "entry:waiting"}],
    "effect_audit": [{"op": "trace", "value": "effect:audit"}]
  },
  "script": [{"op": "start"}, {"op": "dispatch", "event": "go"}],
  "expect": {
    "state": "/RootTransitionEffectCallReentrancy/done",
    "trace": [
      {"type": "dispatch", "event": "go"},
      {"type": "trace", "value": "exit:idle"},
      {"type": "trace", "value": "operation:audit"},
      {"type": "trace", "value": "effect:go"},
      {"type": "trace", "value": "entry:waiting"},
      {"type": "trace", "value": "effect:audit"},
      {"type": "stable", "state": "/RootTransitionEffectCallReentrancy/done"}
    ]
  }
}
