{
  "version": "hsm-conformance-v1",
  "name": "group_dispatch_after_restart_preserves_membership",
  "description": "Group membership survives a member restart and group dispatch includes the restarted member once it is started again.",
  "features": ["group", "lifecycle", "restart"],
  "model": {
    "name": "GroupDispatchAfterRestartPreservesMembership",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "dirty",
            "target": "dirty"
          },
          {
            "on": "go",
            "target": "done",
            "effects": [
              {
                "behavior": "effect_go"
              }
            ]
          }
        ]
      },
      {
        "name": "dirty"
      },
      {
        "name": "done"
      }
    ]
  },
  "instances": [
    {
      "id": "reset"
    },
    {
      "id": "sibling"
    },
    {
      "id": "stopped"
    }
  ],
  "groups": [
    {
      "id": "fleet",
      "members": [
        "reset",
        "sibling",
        "stopped"
      ]
    }
  ],
  "behaviors": {
    "effect_go": [
      {
        "op": "trace",
        "value": "effect:go"
      }
    ]
  },
  "script": [
    {
      "op": "start",
      "instance": "reset"
    },
    {
      "op": "start",
      "instance": "sibling"
    },
    {
      "op": "start",
      "instance": "stopped"
    },
    {
      "op": "dispatch_to",
      "target": "reset",
      "event": "dirty"
    },
    {
      "op": "restart",
      "instance": "reset"
    },
    {
      "op": "stop",
      "instance": "stopped"
    },
    {
      "op": "group_dispatch",
      "group": "fleet",
      "event": "go"
    }
  ],
  "expect": {
    "states": {
      "reset": "/GroupDispatchAfterRestartPreservesMembership/done",
      "sibling": "/GroupDispatchAfterRestartPreservesMembership/done",
      "stopped": ""
    },
    "trace": [
      {
        "type": "dispatch",
        "event": "dirty",
        "target": "reset"
      },
      {
        "type": "dispatch",
        "event": "go",
        "target": "fleet"
      },
      {
        "type": "trace",
        "value": "effect:go"
      },
      {
        "type": "trace",
        "value": "effect:go"
      },
      {
        "type": "stable",
        "state": "group:fleet"
      }
    ]
  }
}
