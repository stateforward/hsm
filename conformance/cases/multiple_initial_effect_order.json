{
  "version": "hsm-conformance-v1",
  "name": "multiple_initial_effect_order",
  "description": "Multiple initial transition effects execute in declaration order before target entry.",
  "features": ["initial", "effect", "entry", "selection_order"],
  "model": {
    "name": "MultipleInitialEffectOrder",
    "initial": {
      "target": "idle",
      "effects": [
        {
          "behavior": "initial_effect_1"
        },
        {
          "behavior": "initial_effect_2"
        }
      ]
    },
    "states": [
      {
        "name": "idle",
        "entry": [
          {
            "behavior": "entry_idle"
          }
        ]
      }
    ]
  },
  "behaviors": {
    "initial_effect_1": [
      {
        "op": "trace",
        "value": "initial:effect:1"
      }
    ],
    "initial_effect_2": [
      {
        "op": "trace",
        "value": "initial:effect:2"
      }
    ],
    "entry_idle": [
      {
        "op": "trace",
        "value": "entry:idle"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    }
  ],
  "expect": {
    "state": "/MultipleInitialEffectOrder/idle",
    "trace": [
      {
        "type": "trace",
        "value": "initial:effect:1"
      },
      {
        "type": "trace",
        "value": "initial:effect:2"
      },
      {
        "type": "trace",
        "value": "entry:idle"
      },
      {
        "type": "stable",
        "state": "/MultipleInitialEffectOrder/idle"
      }
    ]
  }
}
