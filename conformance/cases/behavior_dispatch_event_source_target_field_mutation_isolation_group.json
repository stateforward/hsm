{
  "version": "hsm-conformance-v1",
  "name": "behavior_dispatch_event_source_target_field_mutation_isolation_group",
  "description": "Behavior-originated group dispatch recipients each see behavior-declared source and target fields before local mutation, proving group routing metadata does not overwrite reserved event fields.",
  "features": [
    "event_ownership",
    "group",
    "queue",
    "reentrancy",
    "guard"
  ],
  "model": {
    "name": "BehaviorDispatchEventSourceTargetFieldMutationIsolationGroup",
    "initial": "listening",
    "states": [
      {
        "name": "listening",
        "transitions": [
          {
            "on": "go",
            "effects": [
              {
                "behavior": "dispatch_mutate"
              }
            ]
          },
          {
            "on": "mutate",
            "guard": {
              "behavior": "source_and_target_original"
            },
            "target": "done",
            "effects": [
              {
                "behavior": "mutate_source_target"
              }
            ]
          },
          {
            "on": "mutate",
            "target": "leaked",
            "effects": [
              {
                "behavior": "effect_leaked"
              }
            ]
          }
        ]
      },
      {
        "name": "done"
      },
      {
        "name": "leaked"
      }
    ]
  },
  "instances": [
    {
      "id": "producer"
    },
    {
      "id": "peer"
    }
  ],
  "groups": [
    {
      "id": "both",
      "members": [
        "producer",
        "peer"
      ]
    }
  ],
  "behaviors": {
    "dispatch_mutate": [
      {
        "op": "dispatch",
        "group": "both",
        "event": {
          "name": "mutate",
          "id": "evt-1",
          "source": "declared-source",
          "target": "declared-target"
        }
      }
    ],
    "source_and_target_original": [
      {
        "op": "trace",
        "value": "guard:source-target-original"
      },
      {
        "op": "event_metadata_equals",
        "name": "source",
        "value": "declared-source"
      },
      {
        "op": "event_metadata_equals",
        "name": "target",
        "value": "declared-target"
      }
    ],
    "mutate_source_target": [
      {
        "op": "event_metadata_set",
        "name": "source",
        "value": "changed-source"
      },
      {
        "op": "event_metadata_set",
        "name": "target",
        "value": "changed-target"
      },
      {
        "op": "trace",
        "value": "effect:isolated"
      }
    ],
    "effect_leaked": [
      {
        "op": "trace",
        "value": "effect:leaked"
      }
    ]
  },
  "script": [
    {
      "op": "start",
      "instance": "producer"
    },
    {
      "op": "start",
      "instance": "peer"
    },
    {
      "op": "dispatch_to",
      "target": "producer",
      "event": "go"
    }
  ],
  "expect": {
    "states": {
      "producer": "/BehaviorDispatchEventSourceTargetFieldMutationIsolationGroup/done",
      "peer": "/BehaviorDispatchEventSourceTargetFieldMutationIsolationGroup/done"
    },
    "trace": [
      {
        "type": "dispatch",
        "event": "go",
        "target": "producer"
      },
      {
        "type": "dispatch",
        "event": "mutate",
        "target": "both"
      },
      {
        "type": "trace",
        "value": "guard:source-target-original"
      },
      {
        "type": "trace",
        "value": "effect:isolated"
      },
      {
        "type": "trace",
        "value": "guard:source-target-original"
      },
      {
        "type": "trace",
        "value": "effect:isolated"
      },
      {
        "type": "stable",
        "state": "producer"
      }
    ]
  }
}
