{
  "version": "hsm-conformance-v1",
  "name": "invalid_final_entry_behavior",
  "mode": "validation",
  "description": "Final states must not declare state entry behaviors.",
  "features": ["final", "entry", "validation"],
  "model": {
    "name": "InvalidFinalEntryBehavior",
    "initial": "done",
    "states": [
      {
        "name": "done",
        "kind": "final",
        "entry": [
          {
            "behavior": "entry_done"
          }
        ]
      }
    ]
  },
  "behaviors": {
    "entry_done": [
      {
        "op": "trace",
        "value": "entry:done"
      }
    ]
  },
  "expect": {
    "validation": [
      {
        "code": "invalid_final_transition"
      }
    ]
  }
}
