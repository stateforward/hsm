{
  "version": "hsm-conformance-v1",
  "name": "invalid_history_child_state",
  "mode": "validation",
  "description": "History pseudostates must not declare nested child states.",
  "features": ["history", "validation"],
  "model": {
    "name": "InvalidHistoryChildState",
    "initial": "parent",
    "states": [
      {
        "name": "parent",
        "initial": "h",
        "states": [
          {
            "name": "h",
            "kind": "shallow_history",
            "states": [
              {
                "name": "child"
              }
            ],
            "transitions": [
              {
                "target": "idle"
              }
            ]
          },
          {
            "name": "idle"
          }
        ]
      }
    ]
  },
  "expect": {
    "validation": [
      {
        "code": "invalid_pseudostate_contents"
      }
    ]
  }
}
