{
  "version": "hsm-conformance-v1",
  "name": "set_attr_from_event_data_type_mismatch_error",
  "description": "set_attr_from_event_data reports a normalized error when extracted event data does not match the target attribute type.",
  "features": ["attribute", "initial", "error"],
  "model": {
    "name": "SetAttrFromEventDataTypeMismatchError",
    "initial": {
      "target": "idle",
      "effects": [
        {
          "behavior": "capture_seed"
        }
      ]
    },
    "attributes": {
      "seed": {
        "type": "number",
        "default": 0
      }
    },
    "states": [
      {
        "name": "idle"
      }
    ]
  },
  "instances": [
    {
      "id": "default",
      "data": {
        "seed": "wrong"
      }
    }
  ],
  "behaviors": {
    "capture_seed": [
      {
        "op": "set_attr_from_event_data",
        "name": "seed",
        "path": "seed"
      }
    ]
  },
  "script": [
    {
      "op": "start",
      "instance": "default"
    }
  ],
  "expect": {
    "state": "/SetAttrFromEventDataTypeMismatchError",
    "error": {
      "code": "attribute_error",
      "message_contains": "seed"
    },
    "trace": [
      {
        "type": "error",
        "code": "attribute_error"
      },
      {
        "type": "stable",
        "state": "/SetAttrFromEventDataTypeMismatchError"
      }
    ]
  }
}
