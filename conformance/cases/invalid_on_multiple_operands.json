{
  "version": "hsm-conformance-v1",
  "name": "invalid_on_multiple_operands",
  "mode": "validation",
  "description": "An on trigger must not declare both event and events operands.",
  "features": ["validation"],
  "model": {
    "name": "InvalidOnMultipleOperands",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "trigger": {
              "kind": "on",
              "event": "go",
              "events": ["go", "again"]
            },
            "target": "done"
          }
        ]
      },
      {
        "name": "done"
      }
    ]
  },
  "expect": {
    "validation": [
      {
        "code": "multiple_trigger_operands"
      }
    ]
  }
}
