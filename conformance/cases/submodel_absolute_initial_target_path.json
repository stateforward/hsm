{
  "version": "hsm-conformance-v1",
  "name": "submodel_absolute_initial_target_path",
  "description": "A reusable child model can resolve an absolute root initial target against the child model root.",
  "features": [
    "submachine",
    "initial",
    "path_resolution"
  ],
  "model": {
    "name": "SubmodelAbsoluteInitialTargetPath",
    "initial": "drive",
    "states": [
      {
        "name": "drive",
        "kind": "submachine",
        "machine": "ChildAbsoluteInitialTargetPath"
      }
    ]
  },
  "models": [
    {
      "name": "ChildAbsoluteInitialTargetPath",
      "initial": "/ChildAbsoluteInitialTargetPath/parent/leaf",
      "states": [
        {
          "name": "parent",
          "entry": [
            {
              "behavior": "entry_parent"
            }
          ],
          "states": [
            {
              "name": "leaf",
              "entry": [
                {
                  "behavior": "entry_leaf"
                }
              ]
            }
          ]
        },
        {
          "name": "wrong"
        }
      ]
    }
  ],
  "behaviors": {
    "entry_parent": [
      {
        "op": "trace",
        "value": "entry:parent"
      }
    ],
    "entry_leaf": [
      {
        "op": "trace",
        "value": "entry:leaf"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    }
  ],
  "expect": {
    "state": "/SubmodelAbsoluteInitialTargetPath/drive/ChildAbsoluteInitialTargetPath/parent/leaf",
    "trace": [
      {
        "type": "trace",
        "value": "entry:parent"
      },
      {
        "type": "trace",
        "value": "entry:leaf"
      },
      {
        "type": "stable",
        "state": "/SubmodelAbsoluteInitialTargetPath/drive/ChildAbsoluteInitialTargetPath/parent/leaf"
      }
    ]
  }
}
