{
  "version": "hsm-conformance-v1",
  "name": "runtime_subcontext_flattened_lookup",
  "description": "A Subcontext stores only direct child paths while exact paths resolve from the flattened store.",
  "features": ["runtime_context", "subcontext"],
  "model": {
    "name": "RuntimeSubcontextLookup",
    "states": [{"name": "idle"}],
    "initial": "idle"
  },
  "script": [
    {"op": "start"},
    {
      "op": "context",
      "id": "child",
      "path": "/root",
      "values": {
        "/root/state": "ready",
        "/root/child/count": 3,
        "/root/child/replaced": "old",
        "/root/child/grandchild/value": 4
      }
    }
  ],
  "expect": {
    "state": "/RuntimeSubcontextLookup/idle",
    "context": {
      "view": "child",
      "paths": ["/root/state", "/root/child"],
      "values": {
        "state": "ready",
        "child/count": 3,
        "/root/child/replaced": "old",
        "child/grandchild/value": 4
      }
    }
  }
}
