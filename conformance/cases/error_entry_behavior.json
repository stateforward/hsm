{
  "version": "hsm-conformance-v1",
  "name": "error_entry_behavior",
  "description": "An entry behavior error produces a normalized runtime error after the transition effect and leaves the source state active.",
  "features": [
    "error",
    "entry"
  ],
  "model": {
    "name": "ErrorEntryBehavior",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "go",
            "target": "done",
            "effects": [
              {
                "behavior": "effect_go"
              }
            ]
          }
        ]
      },
      {
        "name": "done",
        "entry": [
          {
            "behavior": "entry_raises"
          }
        ]
      }
    ]
  },
  "behaviors": {
    "effect_go": [
      {
        "op": "trace",
        "value": "effect:go"
      }
    ],
    "entry_raises": [
      {
        "op": "trace",
        "value": "entry:raise"
      },
      {
        "op": "raise",
        "code": "entry_error",
        "value": "entry boom"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "go"
    }
  ],
  "expect": {
    "state": "/ErrorEntryBehavior/idle",
    "error": {
      "code": "entry_error",
      "message_contains": "entry boom"
    },
    "trace": [
      {
        "type": "dispatch",
        "event": "go"
      },
      {
        "type": "trace",
        "value": "effect:go"
      },
      {
        "type": "trace",
        "value": "entry:raise"
      },
      {
        "type": "error",
        "code": "entry_error"
      },
      {
        "type": "stable",
        "state": "/ErrorEntryBehavior/idle"
      }
    ]
  }
}
