{
  "version": "hsm-conformance-v1",
  "name": "invalid_deep_history_entry",
  "mode": "validation",
  "description": "Deep history pseudostates must not declare entry behaviors.",
  "features": ["history", "deep_history", "entry", "validation"],
  "model": {
    "name": "InvalidDeepHistoryEntry",
    "initial": "parent",
    "states": [
      {
        "name": "parent",
        "initial": "h",
        "states": [
          {
            "name": "h",
            "kind": "deep_history",
            "entry": [
              {
                "behavior": "entry_h"
              }
            ],
            "transitions": [
              {
                "target": "idle"
              }
            ]
          },
          {
            "name": "idle"
          }
        ]
      }
    ]
  },
  "behaviors": {
    "entry_h": [
      {
        "op": "trace",
        "value": "entry:h"
      }
    ]
  },
  "expect": {
    "validation": [
      {
        "code": "invalid_pseudostate_contents"
      }
    ]
  }
}
