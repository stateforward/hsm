{
  "version": "hsm-conformance-v1",
  "name": "error_guard_behavior",
  "description": "A guard behavior error produces a normalized runtime error during transition selection and leaves the state unchanged.",
  "features": [
    "error",
    "guard"
  ],
  "model": {
    "name": "ErrorGuardBehavior",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "go",
            "guard": {
              "behavior": "guard_raises"
            },
            "target": "done"
          }
        ]
      },
      {
        "name": "done"
      }
    ]
  },
  "behaviors": {
    "guard_raises": [
      {
        "op": "trace",
        "value": "guard:raise"
      },
      {
        "op": "raise",
        "code": "guard_error",
        "value": "guard boom"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "go"
    }
  ],
  "expect": {
    "state": "/ErrorGuardBehavior/idle",
    "error": {
      "code": "guard_error",
      "message_contains": "guard boom"
    },
    "trace": [
      {
        "type": "dispatch",
        "event": "go"
      },
      {
        "type": "trace",
        "value": "guard:raise"
      },
      {
        "type": "error",
        "code": "guard_error"
      },
      {
        "type": "stable",
        "state": "/ErrorGuardBehavior/idle"
      }
    ]
  }
}
