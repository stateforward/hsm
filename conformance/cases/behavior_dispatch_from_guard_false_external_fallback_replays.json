{
  "version": "hsm-conformance-v1",
  "name": "behavior_dispatch_from_guard_false_external_fallback_replays",
  "description": "A dispatch behavior op from a false guard is replayed only after a later external fallback transition enters its target.",
  "features": ["guard", "queue", "reentrancy", "selection_order"],
  "model": {"name": "BehaviorDispatchFromGuardFalseExternalFallbackReplays", "initial": "idle", "states": [{"name": "idle", "transitions": [{"on": "go", "guard": {"behavior": "guard_dispatch_false"}, "target": "wrong"}, {"on": "go", "target": "waiting", "effects": [{"behavior": "effect_fallback"}]}]}, {"name": "waiting", "entry": [{"behavior": "entry_waiting"}], "transitions": [{"on": "audit", "target": "audit_handled", "effects": [{"behavior": "effect_audit"}]}]}, {"name": "wrong"}, {"name": "audit_handled"}]},
  "behaviors": {"guard_dispatch_false": [{"op": "trace", "value": "guard:before-dispatch"}, {"op": "dispatch", "event": "audit"}, {"op": "return_value", "value": false}], "effect_fallback": [{"op": "trace", "value": "effect:fallback"}], "entry_waiting": [{"op": "trace", "value": "entry:waiting"}], "effect_audit": [{"op": "trace", "value": "effect:audit"}]},
  "script": [{"op": "start"}, {"op": "dispatch", "event": "go"}],
  "expect": {"state": "/BehaviorDispatchFromGuardFalseExternalFallbackReplays/audit_handled", "trace": [{"type": "dispatch", "event": "go"}, {"type": "trace", "value": "guard:before-dispatch"}, {"type": "dispatch", "event": "audit"}, {"type": "trace", "value": "effect:fallback"}, {"type": "trace", "value": "entry:waiting"}, {"type": "trace", "value": "effect:audit"}, {"type": "stable", "state": "/BehaviorDispatchFromGuardFalseExternalFallbackReplays/audit_handled"}]}
}
