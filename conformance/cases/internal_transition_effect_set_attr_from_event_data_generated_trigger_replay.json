{
  "version": "hsm-conformance-v1",
  "name": "internal_transition_effect_set_attr_from_event_data_generated_trigger_replay",
  "description": "Attribute work generated from a internal transition effect replays according to the transition kind lifecycle.",
  "features": [
    "attribute",
    "event_data",
    "on_set",
    "when",
    "transition_kind",
    "internal",
    "effect",
    "queue",
    "reentrancy"
  ],
  "model": {
    "name": "InternalTransitionEffectSetAttrFromEventDataGeneratedTriggerReplay",
    "initial": "active",
    "attributes": {
      "flag": {
        "type": "any",
        "default": null
      },
      "ready_flag": {
        "type": "boolean",
        "default": false
      }
    },
    "states": [
      {
        "name": "active",
        "entry": [],
        "transitions": [
          {
            "on": "go",
            "kind": "internal",
            "effects": [
              {
                "behavior": "set_effect"
              }
            ]
          },
          {
            "trigger": {
              "kind": "on_set",
              "attribute": "flag"
            },
            "target": "seen",
            "effects": [
              {
                "behavior": "effect_flag"
              }
            ]
          }
        ]
      },
      {
        "name": "seen",
        "entry": [
          {
            "behavior": "entry_seen"
          }
        ],
        "transitions": [
          {
            "trigger": {
              "kind": "when",
              "behavior": "ready_when"
            },
            "target": "ready",
            "effects": [
              {
                "behavior": "effect_ready"
              }
            ]
          }
        ]
      },
      {
        "name": "ready"
      }
    ]
  },
  "behaviors": {
    "set_effect": [
      {
        "op": "set_attr_from_event_data",
        "name": "flag",
        "path": ""
      },
      {
        "op": "set_attr",
        "name": "ready_flag",
        "value": true
      },
      {
        "op": "trace",
        "value": "effect:set"
      }
    ],
    "ready_when": [
      {
        "op": "return_equals",
        "name": "ready_flag",
        "value": true
      }
    ],
    "effect_flag": [
      {
        "op": "trace",
        "value": "effect:flag"
      }
    ],
    "entry_seen": [
      {
        "op": "trace",
        "value": "entry:seen"
      }
    ],
    "effect_ready": [
      {
        "op": "trace",
        "value": "effect:ready"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": {
        "name": "go",
        "data": {
          "payload": true
        }
      }
    }
  ],
  "expect": {
    "state": "/InternalTransitionEffectSetAttrFromEventDataGeneratedTriggerReplay/ready",
    "attributes": {
      "ready_flag": true
    },
    "trace": [
      {
        "type": "dispatch",
        "event": "go"
      },
      {
        "type": "trace",
        "value": "effect:set"
      },
      {
        "type": "trace",
        "value": "effect:flag"
      },
      {
        "type": "trace",
        "value": "entry:seen"
      },
      {
        "type": "trace",
        "value": "effect:ready"
      },
      {
        "type": "stable",
        "state": "/InternalTransitionEffectSetAttrFromEventDataGeneratedTriggerReplay/ready"
      }
    ]
  }
}
