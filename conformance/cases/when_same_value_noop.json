{
  "version": "hsm-conformance-v1",
  "name": "when_same_value_noop",
  "description": "Setting an attribute to its current value does not re-evaluate when transitions.",
  "features": [
    "attribute",
    "when"
  ],
  "model": {
    "name": "WhenSameValueNoop",
    "initial": "idle",
    "attributes": {
      "ready_flag": {
        "type": "boolean",
        "default": false
      }
    },
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "trigger": {
              "kind": "when",
              "behavior": "when_ready"
            },
            "target": "ready"
          }
        ]
      },
      {
        "name": "ready"
      }
    ]
  },
  "behaviors": {
    "when_ready": [
      {
        "op": "trace",
        "value": "when:ready"
      },
      {
        "op": "return_equals",
        "name": "ready_flag",
        "value": true
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "set",
      "attribute": "ready_flag",
      "value": false
    }
  ],
  "expect": {
    "state": "/WhenSameValueNoop/idle",
    "attributes": {
      "ready_flag": false
    },
    "trace": [
      {
        "type": "set",
        "attribute": "ready_flag",
        "value": false
      },
      {
        "type": "stable",
        "state": "/WhenSameValueNoop/idle"
      }
    ]
  }
}
