{
  "version": "hsm-conformance-v1",
  "name": "invalid_submodel_exit_point_effect_behavior",
  "mode": "validation",
  "description": "Exit-point effect behavior references inside child models must be validated recursively.",
  "features": ["submachine", "exit_point", "validation"],
  "model": {
    "name": "InvalidSubmodelExitPointEffectBehavior",
    "initial": "drive",
    "states": [
      {
        "name": "drive",
        "kind": "submachine",
        "machine": "ChildWithMissingExitPointEffect"
      }
    ]
  },
  "models": [
    {
      "name": "ChildWithMissingExitPointEffect",
      "initial": "idle",
      "exit_points": [
        {
          "name": "done",
          "effects": [
            {
              "behavior": "missing_child_exit_point_effect"
            }
          ]
        }
      ],
      "states": [
        {
          "name": "idle"
        }
      ]
    }
  ],
  "expect": {
    "validation": [
      {
        "code": "missing_behavior"
      }
    ]
  }
}
