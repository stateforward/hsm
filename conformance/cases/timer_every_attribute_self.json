{
  "version": "hsm-conformance-v1",
  "name": "timer_every_attribute_self",
  "description": "An every timer can use an attribute interval and reschedule while a self transition keeps the source state active.",
  "features": [
    "timer",
    "every",
    "attribute",
    "self"
  ],
  "model": {
    "name": "TimerEveryAttributeSelf",
    "initial": "waiting",
    "attributes": {
      "interval_ms": {
        "type": "duration_ms",
        "default": 10
      }
    },
    "states": [
      {
        "name": "waiting",
        "transitions": [
          {
            "trigger": {
              "kind": "every",
              "attribute": "interval_ms"
            },
            "kind": "self",
            "target": "waiting",
            "effects": [
              {
                "behavior": "effect_tick"
              }
            ]
          },
          {
            "on": "stop",
            "target": "done"
          }
        ]
      },
      {
        "name": "done"
      }
    ]
  },
  "behaviors": {
    "effect_tick": [
      {
        "op": "trace",
        "value": "effect:tick"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "tick",
      "millis": 10
    },
    {
      "op": "tick",
      "millis": 10
    },
    {
      "op": "dispatch",
      "event": "stop"
    }
  ],
  "expect": {
    "state": "/TimerEveryAttributeSelf/done",
    "trace": [
      {
        "type": "timer_scheduled"
      },
      {
        "type": "timer_fired"
      },
      {
        "type": "trace",
        "value": "effect:tick"
      },
      {
        "type": "timer_scheduled"
      },
      {
        "type": "timer_fired"
      },
      {
        "type": "trace",
        "value": "effect:tick"
      },
      {
        "type": "timer_scheduled"
      },
      {
        "type": "dispatch",
        "event": "stop"
      },
      {
        "type": "timer_cancelled"
      },
      {
        "type": "stable",
        "state": "/TimerEveryAttributeSelf/done"
      }
    ]
  }
}
