{
  "version": "hsm-conformance-v1",
  "name": "false_guard_set_attr_from_event_data_generated_trigger_replay",
  "description": "A false guard can copy event data into attributes and replay generated attribute work only after fallback selection settles.",
  "features": ["attribute", "event_data", "on_set", "when", "guard", "queue", "reentrancy", "selection_order"],
  "model": {
    "name": "FalseGuardSetAttrFromEventDataGeneratedTriggerReplay",
    "initial": "idle",
    "attributes": {
      "flag": {"type": "boolean", "default": false},
      "ready": {"type": "boolean", "default": false}
    },
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "submit",
            "guard": {"behavior": "guard_capture_false"},
            "target": "wrong"
          },
          {
            "on": "submit",
            "target": "waiting",
            "effects": [{"behavior": "effect_fallback"}]
          }
        ]
      },
      {
        "name": "waiting",
        "entry": [{"behavior": "entry_waiting"}],
        "transitions": [
          {
            "trigger": {"kind": "on_set", "attribute": "flag"},
            "target": "flag_seen",
            "effects": [{"behavior": "effect_flag"}]
          }
        ]
      },
      {
        "name": "flag_seen",
        "entry": [{"behavior": "entry_flag"}],
        "transitions": [
          {
            "trigger": {"kind": "when", "behavior": "ready_when"},
            "target": "all_seen",
            "effects": [{"behavior": "effect_ready"}]
          }
        ]
      },
      {"name": "all_seen", "entry": [{"behavior": "entry_all"}]},
      {"name": "wrong"}
    ]
  },
  "behaviors": {
    "guard_capture_false": [
      {"op": "set_attr_from_event_data", "name": "flag", "path": "flag"},
      {"op": "set_attr_from_event_data", "name": "ready", "path": "ready"},
      {"op": "trace", "value": "guard:false"},
      {"op": "return_value", "value": false}
    ],
    "ready_when": [{"op": "return_equals", "name": "ready", "value": true}],
    "effect_fallback": [{"op": "trace", "value": "effect:fallback"}],
    "entry_waiting": [{"op": "trace", "value": "entry:waiting"}],
    "effect_flag": [{"op": "trace", "value": "effect:flag"}],
    "entry_flag": [{"op": "trace", "value": "entry:flag"}],
    "effect_ready": [{"op": "trace", "value": "effect:ready"}],
    "entry_all": [{"op": "trace", "value": "entry:all"}]
  },
  "script": [
    {"op": "start"},
    {"op": "dispatch", "event": {"name": "submit", "data": {"flag": true, "ready": true}}}
  ],
  "expect": {
    "state": "/FalseGuardSetAttrFromEventDataGeneratedTriggerReplay/all_seen",
    "attributes": {
      "flag": true,
      "ready": true
    },
    "trace": [
      {"type": "dispatch", "event": "submit"},
      {"type": "trace", "value": "guard:false"},
      {"type": "trace", "value": "effect:fallback"},
      {"type": "trace", "value": "entry:waiting"},
      {"type": "trace", "value": "effect:flag"},
      {"type": "trace", "value": "entry:flag"},
      {"type": "trace", "value": "effect:ready"},
      {"type": "trace", "value": "entry:all"},
      {"type": "stable", "state": "/FalseGuardSetAttrFromEventDataGeneratedTriggerReplay/all_seen"}
    ]
  }
}
