{
  "version": "hsm-conformance-v1",
  "name": "submachine_defer_queue_cleared_on_parent_stop_start",
  "description": "Stopping and starting a parent instance clears deferred events queued inside an active child submachine state.",
  "features": [
    "submachine",
    "defer",
    "queue",
    "lifecycle",
    "stop"
  ],
  "model": {
    "name": "SubmachineDeferQueueClearedOnParentStopStart",
    "initial": "drive",
    "states": [
      {
        "name": "drive",
        "kind": "submachine",
        "machine": "ChildSubmachineDeferCleanupOnStopStart"
      }
    ]
  },
  "models": [
    {
      "name": "ChildSubmachineDeferCleanupOnStopStart",
      "initial": "blocked",
      "states": [
        {
          "name": "blocked",
          "defer": [
            "work"
          ],
          "transitions": [
            {
              "on": "release",
              "target": "ready"
            }
          ]
        },
        {
          "name": "ready",
          "transitions": [
            {
              "on": "work",
              "target": "done",
              "effects": [
                {
                  "behavior": "effect_work"
                }
              ]
            }
          ]
        },
        {
          "name": "done"
        }
      ]
    }
  ],
  "behaviors": {
    "effect_work": [
      {
        "op": "trace",
        "value": "effect:work"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "work"
    },
    {
      "op": "stop"
    },
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "release"
    }
  ],
  "expect": {
    "state": "/SubmachineDeferQueueClearedOnParentStopStart/drive/ready",
    "queue": {
      "lifecycle_cleanup": "child_deferred_events_cleared_on_parent_stop_start"
    },
    "trace": [
      {
        "type": "dispatch",
        "event": "work"
      },
      {
        "type": "defer",
        "event": "work"
      },
      {
        "type": "dispatch",
        "event": "release"
      },
      {
        "type": "stable",
        "state": "/SubmachineDeferQueueClearedOnParentStopStart/drive/ready"
      }
    ]
  }
}
