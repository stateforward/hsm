{
  "version": "hsm-conformance-v1",
  "name": "root_transition_guard_call_reentrancy",
  "description": "A behavior-side operation call from a root-owned transition guard queues its on_call event behind the selected global transition.",
  "features": ["operation", "on_call", "guard", "root_transition", "queue", "reentrancy"],
  "model": {
    "name": "RootTransitionGuardCallReentrancy",
    "initial": "idle",
    "operations": {"audit": {"behavior": "operation_audit"}},
    "states": [
      {"name": "idle"},
      {
        "name": "waiting",
        "entry": [{"behavior": "entry_waiting"}],
        "transitions": [
          {
            "trigger": {"kind": "on_call", "operation": "audit"},
            "target": "done",
            "effects": [{"behavior": "effect_audit"}]
          }
        ]
      },
      {"name": "done"}
    ],
    "transitions": [
      {"on": "go", "guard": {"behavior": "guard_call"}, "target": "waiting"}
    ]
  },
  "behaviors": {
    "operation_audit": [{"op": "trace", "value": "operation:audit"}],
    "guard_call": [
      {"op": "trace", "value": "guard:before-call"},
      {"op": "call", "name": "audit"},
      {"op": "return_value", "value": true}
    ],
    "entry_waiting": [{"op": "trace", "value": "entry:waiting"}],
    "effect_audit": [{"op": "trace", "value": "effect:audit"}]
  },
  "script": [{"op": "start"}, {"op": "dispatch", "event": "go"}],
  "expect": {
    "state": "/RootTransitionGuardCallReentrancy/done",
    "trace": [
      {"type": "dispatch", "event": "go"},
      {"type": "trace", "value": "guard:before-call"},
      {"type": "trace", "value": "operation:audit"},
      {"type": "trace", "value": "entry:waiting"},
      {"type": "trace", "value": "effect:audit"},
      {"type": "stable", "state": "/RootTransitionGuardCallReentrancy/done"}
    ]
  }
}
