{
  "version": "hsm-conformance-v1",
  "name": "error_initial_effect",
  "description": "An initial transition effect error produces a normalized startup error before target entry behavior runs.",
  "features": ["error", "initial"],
  "model": {
    "name": "ErrorInitialEffect",
    "initial": {
      "target": "idle",
      "effects": [
        {
          "behavior": "initial_raises"
        }
      ]
    },
    "states": [
      {
        "name": "idle",
        "entry": [
          {
            "behavior": "entry_idle"
          }
        ]
      }
    ]
  },
  "behaviors": {
    "initial_raises": [
      {
        "op": "trace",
        "value": "initial:raise"
      },
      {
        "op": "raise",
        "code": "initial_error",
        "value": "initial boom"
      }
    ],
    "entry_idle": [
      {
        "op": "trace",
        "value": "enter:idle"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    }
  ],
  "expect": {
    "state": "/ErrorInitialEffect",
    "error": {
      "code": "initial_error",
      "message_contains": "initial boom"
    },
    "trace": [
      {
        "type": "trace",
        "value": "initial:raise"
      },
      {
        "type": "error",
        "code": "initial_error"
      },
      {
        "type": "stable",
        "state": "/ErrorInitialEffect"
      }
    ]
  }
}
