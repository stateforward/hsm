{
  "version": "hsm-conformance-v1",
  "name": "submachine_exit_point_ignores_child_state_exit_point",
  "description": "A parent exit-point handler on a submachine state attaches to the composed machine's own exit point, not to a same-named exit point on one of the machine's direct child states, even when the child state's name sorts first.",
  "features": [
    "submachine",
    "exit_point",
    "nested"
  ],
  "model": {
    "name": "SubmachineExitCapture",
    "initial": "drive",
    "states": [
      {
        "name": "drive",
        "kind": "submachine",
        "machine": "ExitCaptureChild",
        "transitions": [
          {
            "trigger": {
              "kind": "exit_point",
              "exit_point": "ok"
            },
            "target": "complete",
            "effects": [
              {
                "behavior": "effect_host_ok"
              }
            ]
          }
        ]
      },
      {
        "name": "complete",
        "entry": [
          {
            "behavior": "entry_complete"
          }
        ]
      }
    ]
  },
  "models": [
    {
      "name": "ExitCaptureChild",
      "initial": "community",
      "exit_points": [
        {
          "name": "ok"
        }
      ],
      "states": [
        {
          "name": "community",
          "kind": "submachine",
          "machine": "ExitCaptureInner",
          "transitions": [
            {
              "trigger": {
                "kind": "exit_point",
                "exit_point": "ok"
              },
              "target": "../ok",
              "effects": [
                {
                  "behavior": "effect_child_ok"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "ExitCaptureInner",
      "initial": "idle",
      "exit_points": [
        {
          "name": "ok"
        }
      ],
      "states": [
        {
          "name": "idle",
          "transitions": [
            {
              "on": "finish",
              "target": "../ok",
              "effects": [
                {
                  "behavior": "effect_inner_finish"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "behaviors": {
    "effect_inner_finish": [
      {
        "op": "trace",
        "value": "effect:inner-finish"
      }
    ],
    "effect_child_ok": [
      {
        "op": "trace",
        "value": "effect:child-ok"
      }
    ],
    "effect_host_ok": [
      {
        "op": "trace",
        "value": "effect:host-ok"
      }
    ],
    "entry_complete": [
      {
        "op": "trace",
        "value": "enter:complete"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "finish"
    }
  ],
  "expect": {
    "state": "/SubmachineExitCapture/complete",
    "trace": [
      {
        "type": "dispatch",
        "event": "finish"
      },
      {
        "type": "trace",
        "value": "effect:inner-finish"
      },
      {
        "type": "trace",
        "value": "effect:child-ok"
      },
      {
        "type": "trace",
        "value": "effect:host-ok"
      },
      {
        "type": "trace",
        "value": "enter:complete"
      },
      {
        "type": "stable",
        "state": "/SubmachineExitCapture/complete"
      }
    ]
  }
}
