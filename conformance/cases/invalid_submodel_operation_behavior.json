{
  "version": "hsm-conformance-v1",
  "name": "invalid_submodel_operation_behavior",
  "mode": "validation",
  "description": "Operation behavior references inside child models must be validated recursively.",
  "features": ["submachine", "operation", "validation"],
  "model": {
    "name": "InvalidSubmodelOperationBehavior",
    "initial": "drive",
    "states": [
      {
        "name": "drive",
        "kind": "submachine",
        "machine": "ChildWithMissingOperationBehavior"
      }
    ]
  },
  "models": [
    {
      "name": "ChildWithMissingOperationBehavior",
      "initial": "idle",
      "operations": {
        "audit": {
          "behavior": "missing_child_operation"
        }
      },
      "states": [
        {
          "name": "idle"
        }
      ]
    }
  ],
  "expect": {
    "validation": [
      {
        "code": "missing_behavior"
      }
    ]
  }
}
