{
  "version": "hsm-conformance-v1",
  "name": "submachine_reused_history_isolation",
  "description": "Sibling submachine states that reuse one child model keep separate child history memories.",
  "features": [
    "submachine",
    "entry_point",
    "history",
    "shallow_history"
  ],
  "model": {
    "name": "SubmachineReuseHistory",
    "initial": "outside",
    "states": [
      {
        "name": "outside",
        "transitions": [
          {
            "on": "enter_first",
            "target": "first"
          },
          {
            "on": "resume_first",
            "target": "first",
            "entry_point": "history"
          },
          {
            "on": "resume_second",
            "target": "second",
            "entry_point": "history"
          }
        ]
      },
      {
        "name": "first",
        "kind": "submachine",
        "machine": "HistoryToggle",
        "transitions": [
          {
            "on": "leave",
            "target": "outside"
          }
        ]
      },
      {
        "name": "second",
        "kind": "submachine",
        "machine": "HistoryToggle",
        "transitions": [
          {
            "on": "leave",
            "target": "outside"
          }
        ]
      }
    ]
  },
  "models": [
    {
      "name": "HistoryToggle",
      "initial": "comp",
      "entry_points": [
        {
          "name": "history",
          "target": "comp/h",
          "effects": [
            {
              "behavior": "effect_history"
            }
          ]
        }
      ],
      "states": [
        {
          "name": "comp",
          "initial": "a",
          "states": [
            {
              "name": "a",
              "entry": [
                {
                  "behavior": "entry_a"
                }
              ],
              "transitions": [
                {
                  "on": "to_b",
                  "target": "../b"
                }
              ]
            },
            {
              "name": "b",
              "entry": [
                {
                  "behavior": "entry_b"
                }
              ]
            },
            {
              "name": "h",
              "kind": "shallow_history",
              "transitions": [
                {
                  "target": "a"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "behaviors": {
    "effect_history": [
      {
        "op": "trace",
        "value": "effect:history"
      }
    ],
    "entry_a": [
      {
        "op": "trace",
        "value": "enter:a"
      }
    ],
    "entry_b": [
      {
        "op": "trace",
        "value": "enter:b"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "enter_first"
    },
    {
      "op": "dispatch",
      "event": "to_b"
    },
    {
      "op": "dispatch",
      "event": "leave"
    },
    {
      "op": "dispatch",
      "event": "resume_second"
    },
    {
      "op": "dispatch",
      "event": "leave"
    },
    {
      "op": "dispatch",
      "event": "resume_first"
    }
  ],
  "expect": {
    "state": "/SubmachineReuseHistory/first/comp/b",
    "trace": [
      {
        "type": "dispatch",
        "event": "enter_first"
      },
      {
        "type": "trace",
        "value": "enter:a"
      },
      {
        "type": "dispatch",
        "event": "to_b"
      },
      {
        "type": "trace",
        "value": "enter:b"
      },
      {
        "type": "dispatch",
        "event": "leave"
      },
      {
        "type": "dispatch",
        "event": "resume_second"
      },
      {
        "type": "trace",
        "value": "effect:history"
      },
      {
        "type": "trace",
        "value": "enter:a"
      },
      {
        "type": "dispatch",
        "event": "leave"
      },
      {
        "type": "dispatch",
        "event": "resume_first"
      },
      {
        "type": "trace",
        "value": "effect:history"
      },
      {
        "type": "trace",
        "value": "enter:b"
      },
      {
        "type": "stable",
        "state": "/SubmachineReuseHistory/first/comp/b"
      }
    ]
  }
}
