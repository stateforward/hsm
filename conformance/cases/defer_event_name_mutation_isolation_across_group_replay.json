{
  "version": "hsm-conformance-v1",
  "name": "defer_event_name_mutation_isolation_across_group_replay",
  "description": "A group-dispatched event that is deferred by multiple recipients preserves event-name isolation when each recipient later replays it.",
  "features": [
    "defer",
    "event_ownership",
    "group"
  ],
  "model": {
    "name": "DeferEventNameMutationIsolationAcrossGroupReplay",
    "initial": "hold",
    "states": [
      {
        "name": "hold",
        "defer": [
          "mutate"
        ],
        "transitions": [
          {
            "on": "release",
            "target": "ready"
          }
        ]
      },
      {
        "name": "ready",
        "transitions": [
          {
            "on": "mutate",
            "guard": {
              "behavior": "name_is_mutate"
            },
            "target": "done",
            "effects": [
              {
                "behavior": "rename_event"
              }
            ]
          },
          {
            "on": "changed",
            "target": "leaked",
            "effects": [
              {
                "behavior": "effect_leaked"
              }
            ]
          }
        ]
      },
      {
        "name": "done"
      },
      {
        "name": "leaked"
      }
    ]
  },
  "instances": [
    {
      "id": "first"
    },
    {
      "id": "second"
    }
  ],
  "groups": [
    {
      "id": "both",
      "members": [
        "first",
        "second"
      ]
    }
  ],
  "behaviors": {
    "name_is_mutate": [
      {
        "op": "trace",
        "value": "guard:name-mutate"
      },
      {
        "op": "event_name_equals",
        "value": "mutate"
      }
    ],
    "rename_event": [
      {
        "op": "event_metadata_set",
        "name": "name",
        "value": "changed"
      },
      {
        "op": "trace",
        "value": "effect:renamed"
      }
    ],
    "effect_leaked": [
      {
        "op": "trace",
        "value": "effect:leaked"
      }
    ]
  },
  "script": [
    {
      "op": "start",
      "instance": "first"
    },
    {
      "op": "start",
      "instance": "second"
    },
    {
      "op": "group_dispatch",
      "group": "both",
      "event": "mutate"
    },
    {
      "op": "dispatch_to",
      "targets": [
        "first",
        "second"
      ],
      "event": "release"
    }
  ],
  "expect": {
    "states": {
      "first": "/DeferEventNameMutationIsolationAcrossGroupReplay/done",
      "second": "/DeferEventNameMutationIsolationAcrossGroupReplay/done"
    },
    "trace": [
      {
        "type": "dispatch",
        "event": "mutate",
        "target": "both"
      },
      {
        "type": "defer",
        "event": "mutate"
      },
      {
        "type": "defer",
        "event": "mutate"
      },
      {
        "type": "dispatch",
        "event": "release",
        "target": [
          "first",
          "second"
        ]
      },
      {
        "type": "undefer",
        "event": "mutate"
      },
      {
        "type": "trace",
        "value": "guard:name-mutate"
      },
      {
        "type": "trace",
        "value": "effect:renamed"
      },
      {
        "type": "undefer",
        "event": "mutate"
      },
      {
        "type": "trace",
        "value": "guard:name-mutate"
      },
      {
        "type": "trace",
        "value": "effect:renamed"
      },
      {
        "type": "stable",
        "state": "targets:first,second"
      }
    ]
  }
}
