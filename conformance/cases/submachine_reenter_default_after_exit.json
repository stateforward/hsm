{
  "version": "hsm-conformance-v1",
  "name": "submachine_reenter_default_after_exit",
  "description": "Re-entering a submachine after a normal parent exit uses default entry unless an entry point or history is explicitly selected.",
  "features": [
    "submachine"
  ],
  "model": {
    "name": "SubmachineReenterDefault",
    "initial": "drive",
    "states": [
      {
        "name": "drive",
        "kind": "submachine",
        "machine": "ReenterChild",
        "transitions": [
          {
            "on": "leave",
            "target": "outside"
          }
        ]
      },
      {
        "name": "outside",
        "transitions": [
          {
            "on": "enter",
            "target": "drive"
          }
        ]
      }
    ]
  },
  "models": [
    {
      "name": "ReenterChild",
      "initial": "a",
      "states": [
        {
          "name": "a",
          "entry": [
            {
              "behavior": "entry_a"
            }
          ],
          "transitions": [
            {
              "on": "advance",
              "target": "b"
            }
          ]
        },
        {
          "name": "b",
          "entry": [
            {
              "behavior": "entry_b"
            }
          ]
        }
      ]
    }
  ],
  "behaviors": {
    "entry_a": [
      {
        "op": "trace",
        "value": "enter:a"
      }
    ],
    "entry_b": [
      {
        "op": "trace",
        "value": "enter:b"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "advance"
    },
    {
      "op": "dispatch",
      "event": "leave"
    },
    {
      "op": "dispatch",
      "event": "enter"
    }
  ],
  "expect": {
    "state": "/SubmachineReenterDefault/drive/a",
    "trace": [
      {
        "type": "trace",
        "value": "enter:a"
      },
      {
        "type": "dispatch",
        "event": "advance"
      },
      {
        "type": "trace",
        "value": "enter:b"
      },
      {
        "type": "dispatch",
        "event": "leave"
      },
      {
        "type": "dispatch",
        "event": "enter"
      },
      {
        "type": "trace",
        "value": "enter:a"
      },
      {
        "type": "stable",
        "state": "/SubmachineReenterDefault/drive/a"
      }
    ]
  }
}
