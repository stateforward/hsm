{
  "version": "hsm-conformance-v1",
  "name": "nested_sibling_external_transition_lca_exit_order",
  "description": "external transition between nested siblings exits only the source child before effects and target entry",
  "features": [
    "core",
    "nested",
    "external",
    "paths"
  ],
  "model": {
    "name": "NestedSiblingExternalTransitionLcaExitOrder",
    "initial": "parent",
    "states": [
      {
        "name": "parent",
        "initial": "a",
        "entry": [
          {
            "behavior": "entry_parent"
          }
        ],
        "exit": [
          {
            "behavior": "exit_parent"
          }
        ],
        "states": [
          {
            "name": "a",
            "entry": [
              {
                "behavior": "entry_a"
              }
            ],
            "exit": [
              {
                "behavior": "exit_a"
              }
            ],
            "transitions": [
              {
                "on": "go",
                "target": "../b",
                "effects": [
                  {
                    "behavior": "effect_go"
                  }
                ]
              }
            ]
          },
          {
            "name": "b",
            "entry": [
              {
                "behavior": "entry_b"
              }
            ]
          }
        ]
      }
    ]
  },
  "behaviors": {
    "entry_parent": [
      {
        "op": "trace",
        "value": "enter:parent"
      }
    ],
    "exit_parent": [
      {
        "op": "trace",
        "value": "exit:parent"
      }
    ],
    "entry_a": [
      {
        "op": "trace",
        "value": "enter:a"
      }
    ],
    "exit_a": [
      {
        "op": "trace",
        "value": "exit:a"
      }
    ],
    "effect_go": [
      {
        "op": "trace",
        "value": "effect:go"
      }
    ],
    "entry_b": [
      {
        "op": "trace",
        "value": "enter:b"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "go"
    }
  ],
  "expect": {
    "state": "/NestedSiblingExternalTransitionLcaExitOrder/parent/b",
    "trace": [
      {
        "type": "trace",
        "value": "enter:parent"
      },
      {
        "type": "trace",
        "value": "enter:a"
      },
      {
        "type": "dispatch",
        "event": "go"
      },
      {
        "type": "trace",
        "value": "exit:a"
      },
      {
        "type": "trace",
        "value": "effect:go"
      },
      {
        "type": "trace",
        "value": "enter:b"
      },
      {
        "type": "stable",
        "state": "/NestedSiblingExternalTransitionLcaExitOrder/parent/b"
      }
    ]
  }
}
