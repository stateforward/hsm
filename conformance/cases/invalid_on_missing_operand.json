{
  "version": "hsm-conformance-v1",
  "name": "invalid_on_missing_operand",
  "mode": "validation",
  "description": "An on trigger must declare event or events.",
  "features": ["validation"],
  "model": {
    "name": "InvalidOnMissingOperand",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "trigger": {
              "kind": "on"
            },
            "target": "done"
          }
        ]
      },
      {
        "name": "done"
      }
    ]
  },
  "expect": {
    "validation": [
      {
        "code": "missing_trigger_operand"
      }
    ]
  }
}
