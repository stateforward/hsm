{
  "version": "hsm-conformance-v1",
  "name": "event_identity_field_mutation_isolation_dispatch_to",
  "description": "multi-target dispatch_to recipients each see the caller event id before local mutation, proving reserved identity field mutation isolation.",
  "features": [
    "event_ownership",
    "dispatch_to",
    "guard"
  ],
  "model": {
    "name": "EventIdentityFieldMutationIsolationDispatchTo",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "mutate",
            "guard": {
              "behavior": "id_is_original"
            },
            "target": "done",
            "effects": [
              {
                "behavior": "mutate_id"
              }
            ]
          },
          {
            "on": "mutate",
            "target": "leaked",
            "effects": [
              {
                "behavior": "effect_leaked"
              }
            ]
          }
        ]
      },
      {
        "name": "done"
      },
      {
        "name": "leaked"
      }
    ]
  },
  "instances": [
    {
      "id": "first"
    },
    {
      "id": "second"
    }
  ],
  "behaviors": {
    "id_is_original": [
      {
        "op": "trace",
        "value": "guard:id-original"
      },
      {
        "op": "event_metadata_equals",
        "name": "id",
        "value": "evt-1"
      }
    ],
    "mutate_id": [
      {
        "op": "event_metadata_set",
        "name": "id",
        "value": "changed"
      },
      {
        "op": "trace",
        "value": "effect:isolated"
      }
    ],
    "effect_leaked": [
      {
        "op": "trace",
        "value": "effect:leaked"
      }
    ]
  },
  "script": [
    {
      "op": "start",
      "instance": "first"
    },
    {
      "op": "start",
      "instance": "second"
    },
    {
      "op": "dispatch_to",
      "targets": [
        "first",
        "second"
      ],
      "event": {
        "name": "mutate",
        "id": "evt-1",
        "source": "client",
        "target": "targets"
      }
    }
  ],
  "expect": {
    "states": {
      "first": "/EventIdentityFieldMutationIsolationDispatchTo/done",
      "second": "/EventIdentityFieldMutationIsolationDispatchTo/done"
    },
    "trace": [
      {
        "type": "dispatch",
        "event": "mutate",
        "target": [
          "first",
          "second"
        ]
      },
      {
        "type": "trace",
        "value": "guard:id-original"
      },
      {
        "type": "trace",
        "value": "effect:isolated"
      },
      {
        "type": "trace",
        "value": "guard:id-original"
      },
      {
        "type": "trace",
        "value": "effect:isolated"
      },
      {
        "type": "stable",
        "state": "targets:first,second"
      }
    ]
  }
}
