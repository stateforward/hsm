{
  "version": "hsm-conformance-v1",
  "name": "behavior_raise_internal_event_order",
  "description": "A behavior can raise a normal internal event that is processed after the current transition reaches its target.",
  "features": ["queue", "reentrancy"],
  "model": {
    "name": "BehaviorRaiseInternalEventOrder",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "go",
            "target": "waiting",
            "effects": [
              {
                "behavior": "raise_audit"
              }
            ]
          }
        ]
      },
      {
        "name": "waiting",
        "transitions": [
          {
            "on": "audit",
            "target": "done",
            "effects": [
              {
                "behavior": "effect_audit"
              }
            ]
          }
        ]
      },
      {
        "name": "done"
      }
    ]
  },
  "behaviors": {
    "raise_audit": [
      {
        "op": "raise",
        "event": "audit"
      },
      {
        "op": "trace",
        "value": "effect:go"
      }
    ],
    "effect_audit": [
      {
        "op": "trace",
        "value": "effect:audit"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "go"
    }
  ],
  "expect": {
    "state": "/BehaviorRaiseInternalEventOrder/done",
    "trace": [
      {
        "type": "dispatch",
        "event": "go"
      },
      {
        "type": "raise",
        "event": "audit"
      },
      {
        "type": "trace",
        "value": "effect:go"
      },
      {
        "type": "trace",
        "value": "effect:audit"
      },
      {
        "type": "stable",
        "state": "/BehaviorRaiseInternalEventOrder/done"
      }
    ]
  }
}
