    "snapshots": {
      "last": {
        "id": "default",
        "qualified_name": "/ConfigQueueLenErrorEvent",
        "state": "/ConfigQueueLenErrorEvent/idle",
        "attributes": {},
        "queue_len": 0,
        "transitions": [
          {
            "name": "/ConfigQueueLenErrorEvent/idle/transition_4",
            "kind": 67343,
            "source": "/ConfigQueueLenErrorEvent/idle",
            "target": "/ConfigQueueLenErrorEvent/failed",
            "events": [
              "hsm/error"
            ],
            "guard": false
          },
          {
            "name": "/ConfigQueueLenErrorEvent/idle/transition_6",
            "kind": 67343,
            "source": "/ConfigQueueLenErrorEvent/idle",
            "target": "/ConfigQueueLenErrorEvent/done",
            "events": [
              "go"
            ],
            "guard": false
