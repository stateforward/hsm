{
  "version": "hsm-conformance-v1",
  "name": "self_transition_guard_set_attr_generated_trigger_after_reentry",
  "description": "Attribute work generated from a self transition guard replays according to the transition kind lifecycle.",
  "features": [
    "on_set",
    "when",
    "transition_kind",
    "self",
    "guard",
    "queue",
    "reentrancy"
  ],
  "model": {
    "name": "SelfTransitionGuardSetAttrGeneratedTriggerAfterReentry",
    "initial": "active",
    "attributes": {
      "flag": {
        "type": "boolean",
        "default": false
      },
      "ready_flag": {
        "type": "boolean",
        "default": false
      }
    },
    "states": [
      {
        "name": "active",
        "entry": [
          {
            "behavior": "entry_seen"
          }
        ],
        "transitions": [
          {
            "on": "go",
            "kind": "self",
            "target": "active",
            "guard": {
              "behavior": "set_guard"
            }
          },
          {
            "trigger": {
              "kind": "on_set",
              "attribute": "flag"
            },
            "target": "seen",
            "effects": [
              {
                "behavior": "effect_flag"
              }
            ]
          }
        ]
      },
      {
        "name": "seen",
        "entry": [
          {
            "behavior": "entry_seen"
          }
        ],
        "transitions": [
          {
            "trigger": {
              "kind": "when",
              "behavior": "ready_when"
            },
            "target": "ready",
            "effects": [
              {
                "behavior": "effect_ready"
              }
            ]
          }
        ]
      },
      {
        "name": "ready"
      }
    ]
  },
  "behaviors": {
    "set_guard": [
      {
        "op": "set_attr",
        "name": "flag",
        "value": true
      },
      {
        "op": "set_attr",
        "name": "ready_flag",
        "value": true
      },
      {
        "op": "trace",
        "value": "guard:true"
      },
      {
        "op": "return_value",
        "value": true
      }
    ],
    "ready_when": [
      {
        "op": "return_equals",
        "name": "ready_flag",
        "value": true
      }
    ],
    "effect_flag": [
      {
        "op": "trace",
        "value": "effect:flag"
      }
    ],
    "entry_seen": [
      {
        "op": "trace",
        "value": "entry:seen"
      }
    ],
    "effect_ready": [
      {
        "op": "trace",
        "value": "effect:ready"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "go"
    }
  ],
  "expect": {
    "state": "/SelfTransitionGuardSetAttrGeneratedTriggerAfterReentry/ready",
    "attributes": {
      "ready_flag": true
    },
    "trace": [
      {
        "type": "trace",
        "value": "entry:seen"
      },
      {
        "type": "dispatch",
        "event": "go"
      },
      {
        "type": "trace",
        "value": "guard:true"
      },
      {
        "type": "trace",
        "value": "entry:seen"
      },
      {
        "type": "trace",
        "value": "effect:flag"
      },
      {
        "type": "trace",
        "value": "entry:seen"
      },
      {
        "type": "trace",
        "value": "effect:ready"
      },
      {
        "type": "stable",
        "state": "/SelfTransitionGuardSetAttrGeneratedTriggerAfterReentry/ready"
      }
    ]
  }
}
