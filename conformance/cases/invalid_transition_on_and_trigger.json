{
  "version": "hsm-conformance-v1",
  "name": "invalid_transition_on_and_trigger",
  "mode": "validation",
  "description": "A transition must not declare both shorthand on and explicit trigger.",
  "features": ["validation"],
  "model": {
    "name": "InvalidTransitionOnAndTrigger",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "go",
            "trigger": {
              "kind": "on",
              "event": "go"
            },
            "target": "done"
          }
        ]
      },
      {
        "name": "done"
      }
    ]
  },
  "expect": {
    "validation": [
      {
        "code": "multiple_transition_triggers"
      }
    ]
  }
}
