{
  "version": "hsm-conformance-v1",
  "name": "invalid_after_timer_time_attribute",
  "mode": "validation",
  "description": "An after timer attribute source must have duration_ms type, not time_ms.",
  "features": ["timer", "after", "validation"],
  "model": {
    "name": "InvalidAfterTimerTimeAttribute",
    "initial": "waiting",
    "attributes": {
      "deadline_ms": {
        "type": "time_ms",
        "default": 10
      }
    },
    "states": [
      {
        "name": "waiting",
        "transitions": [
          {
            "trigger": {
              "kind": "after",
              "attribute": "deadline_ms"
            },
            "target": "done"
          }
        ]
      },
      {
        "name": "done"
      }
    ]
  },
  "expect": {
    "validation": [
      {
        "code": "invalid_timer_attribute_type"
      }
    ]
  }
}
