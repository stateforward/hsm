{
  "version": "hsm-conformance-v1",
  "name": "activity_cancel_on_restart",
  "description": "Restarting an instance cancels a running top-level activity before starting the fresh initial activity.",
  "features": ["activity", "async", "cancellation", "restart"],
  "model": {
    "name": "ActivityCancelOnRestart",
    "initial": "active",
    "states": [{"name": "active", "activity": [{"behavior": "activity_running"}]}]
  },
  "behaviors": {"activity_running": [{"op": "trace", "value": "activity:start"}, {"op": "sleep", "millis": 1000}, {"op": "trace", "value": "activity:done"}]},
  "script": [{"op": "start"}, {"op": "restart"}, {"op": "sleep", "millis": 0}],
  "expect": {
    "state": "/ActivityCancelOnRestart/active",
    "trace": [
      {"type": "trace", "value": "activity:start"},
      {"type": "restart"},
      {"type": "activity_cancel", "behavior": "activity_running"},
      {"type": "trace", "value": "activity:start"},
      {"type": "stable", "state": "/ActivityCancelOnRestart/active"}
    ]
  }
}
