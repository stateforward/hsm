{
  "version": "hsm-conformance-v1",
  "name": "behavior_raise_from_exit_point_effect",
  "description": "A normal internal event raised from an exit-point effect is processed after the parent exit-point transition completes.",
  "features": ["submachine", "exit_point", "queue", "reentrancy"],
  "model": {
    "name": "BehaviorRaiseFromExitPointEffect",
    "initial": "drive",
    "states": [
      {
        "name": "drive",
        "kind": "submachine",
        "machine": "RaiseFromExitPointChild",
        "transitions": [
          {
            "trigger": {
              "kind": "exit_point",
              "exit_point": "done"
            },
            "target": "waiting"
          }
        ]
      },
      {
        "name": "waiting",
        "transitions": [
          {
            "on": "audit",
            "target": "done",
            "effects": [
              {
                "behavior": "effect_audit"
              }
            ]
          }
        ]
      },
      {
        "name": "done"
      }
    ]
  },
  "models": [
    {
      "name": "RaiseFromExitPointChild",
      "initial": "active",
      "exit_points": [
        {
          "name": "done",
          "effects": [
            {
              "behavior": "exit_point_raise"
            }
          ]
        }
      ],
      "states": [
        {
          "name": "active",
          "transitions": [
            {
              "on": "finish",
              "target": "done"
            }
          ]
        }
      ]
    }
  ],
  "behaviors": {
    "exit_point_raise": [
      {
        "op": "raise",
        "event": "audit"
      },
      {
        "op": "trace",
        "value": "effect:exit-point"
      }
    ],
    "effect_audit": [
      {
        "op": "trace",
        "value": "effect:audit"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": "finish"
    }
  ],
  "expect": {
    "state": "/BehaviorRaiseFromExitPointEffect/done",
    "trace": [
      {
        "type": "dispatch",
        "event": "finish"
      },
      {
        "type": "raise",
        "event": "audit"
      },
      {
        "type": "trace",
        "value": "effect:exit-point"
      },
      {
        "type": "trace",
        "value": "effect:audit"
      },
      {
        "type": "stable",
        "state": "/BehaviorRaiseFromExitPointEffect/done"
      }
    ]
  }
}
