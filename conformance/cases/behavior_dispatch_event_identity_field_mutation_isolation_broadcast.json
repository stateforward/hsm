{
  "version": "hsm-conformance-v1",
  "name": "behavior_dispatch_event_identity_field_mutation_isolation_broadcast",
  "description": "Behavior-originated broadcast recipients each see the dispatched event id before local mutation, proving reserved identity field mutation isolation.",
  "features": [
    "event_ownership",
    "broadcast",
    "queue",
    "reentrancy",
    "guard"
  ],
  "model": {
    "name": "BehaviorDispatchEventIdentityFieldMutationIsolationBroadcast",
    "initial": "listening",
    "states": [
      {
        "name": "listening",
        "transitions": [
          {
            "on": "go",
            "effects": [
              {
                "behavior": "dispatch_mutate"
              }
            ]
          },
          {
            "on": "mutate",
            "guard": {
              "behavior": "id_is_original"
            },
            "target": "done",
            "effects": [
              {
                "behavior": "mutate_id"
              }
            ]
          },
          {
            "on": "mutate",
            "target": "leaked",
            "effects": [
              {
                "behavior": "effect_leaked"
              }
            ]
          }
        ]
      },
      {
        "name": "done"
      },
      {
        "name": "leaked"
      }
    ]
  },
  "instances": [
    {
      "id": "producer"
    },
    {
      "id": "peer"
    }
  ],
  "behaviors": {
    "dispatch_mutate": [
      {
        "op": "dispatch",
        "target": "all",
        "event": {
          "name": "mutate",
          "id": "evt-1",
          "source": "producer",
          "target": "all"
        }
      }
    ],
    "id_is_original": [
      {
        "op": "trace",
        "value": "guard:id-original"
      },
      {
        "op": "event_metadata_equals",
        "name": "id",
        "value": "evt-1"
      }
    ],
    "mutate_id": [
      {
        "op": "event_metadata_set",
        "name": "id",
        "value": "changed"
      },
      {
        "op": "trace",
        "value": "effect:isolated"
      }
    ],
    "effect_leaked": [
      {
        "op": "trace",
        "value": "effect:leaked"
      }
    ]
  },
  "script": [
    {
      "op": "start",
      "instance": "producer"
    },
    {
      "op": "start",
      "instance": "peer"
    },
    {
      "op": "dispatch_to",
      "target": "producer",
      "event": "go"
    }
  ],
  "expect": {
    "states": {
      "producer": "/BehaviorDispatchEventIdentityFieldMutationIsolationBroadcast/done",
      "peer": "/BehaviorDispatchEventIdentityFieldMutationIsolationBroadcast/done"
    },
    "trace": [
      {
        "type": "dispatch",
        "event": "go",
        "target": "producer"
      },
      {
        "type": "dispatch",
        "event": "mutate",
        "target": "all"
      },
      {
        "type": "trace",
        "value": "guard:id-original"
      },
      {
        "type": "trace",
        "value": "effect:isolated"
      },
      {
        "type": "trace",
        "value": "guard:id-original"
      },
      {
        "type": "trace",
        "value": "effect:isolated"
      },
      {
        "type": "stable",
        "state": "producer"
      }
    ]
  }
}
