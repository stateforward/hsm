{
  "version": "hsm-conformance-v1",
  "name": "invalid_on_call_missing_operand",
  "mode": "validation",
  "description": "An on_call trigger must declare its operation operand.",
  "features": ["operation", "on_call", "validation"],
  "model": {
    "name": "InvalidOnCallMissingOperand",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "trigger": {
              "kind": "on_call"
            },
            "target": "done"
          }
        ]
      },
      {
        "name": "done"
      }
    ]
  },
  "expect": {
    "validation": [
      {
        "code": "missing_trigger_operand"
      }
    ]
  }
}
