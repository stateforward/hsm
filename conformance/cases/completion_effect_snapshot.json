{
  "version": "hsm-conformance-v1",
  "name": "completion_effect_snapshot",
  "description": "A snapshot taken from a completion transition effect observes the completed final state before the completion target is entered.",
  "features": ["completion", "final", "snapshot"],
  "model": {"name": "CompletionEffectSnapshot", "initial": "work", "states": [{"name": "work", "transitions": [{"on": "finish", "target": "done"}]}, {"name": "done", "kind": "final"}, {"name": "complete", "entry": [{"behavior": "entry_complete"}]}], "transitions": [{"trigger": {"kind": "completion"}, "target": "complete", "effects": [{"behavior": "completion_snapshot"}]}]},
  "behaviors": {"completion_snapshot": [{"op": "snapshot"}], "entry_complete": [{"op": "trace", "value": "entry:complete"}]},
  "script": [{"op": "start"}, {"op": "dispatch", "event": "finish"}],
  "expect": {"state": "/CompletionEffectSnapshot/complete", "trace": [{"type": "dispatch", "event": "finish"}, {"type": "snapshot", "state": "/CompletionEffectSnapshot/done"}, {"type": "trace", "value": "entry:complete"}, {"type": "stable", "state": "/CompletionEffectSnapshot/complete"}]}
}
