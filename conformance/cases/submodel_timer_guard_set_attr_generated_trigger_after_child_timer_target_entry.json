                    {
                      "behavior": "effect_flag"
                    }
                  ]
                }
              ]
            },
            {
              "name": "flag_seen",
              "entry": [
                {
                  "behavior": "entry_flag"
                }
              ],
              "transitions": [
                {
                  "trigger": {
                    "kind": "when",
                    "behavior": "ready_when"
                  },
                  "target": "../all_seen",
                  "effects": [
                    {
                      "behavior": "effect_ready"
                    }
                  ]
                }
              ]
            },
            {
              "name": "all_seen",
              "entry": [
                {
                  "behavior": "entry_all"
                }
              ]
            }
          ]
        },
        {
          "name": "wrong"
        }
      ]
    }
  ],
  "behaviors": {
    "ready_when": [
      {
        "op": "return_equals",
        "name": "ready",
        "value": true
      }
    ],
    "entry_parent": [
      {
        "op": "trace",
        "value": "entry:parent"
      }
