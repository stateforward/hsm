{
  "version": "hsm-conformance-v1",
  "name": "event_metadata_get_falsy_fallback",
  "description": "Falsy values returned by event_metadata_get disable a guarded transition and allow the next matching transition to run.",
  "features": [
    "event_ownership",
    "guard",
    "selection_order"
  ],
  "model": {
    "name": "EventMetadataGetFalsy",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "trigger": {
              "kind": "on",
              "event": "submit"
            },
            "guard": {
              "behavior": "metadata_flag"
            },
            "target": "accepted",
            "effects": [
              {
                "behavior": "effect_accepted"
              }
            ]
          },
          {
            "trigger": {
              "kind": "on",
              "event": "submit"
            },
            "target": "fallback",
            "effects": [
              {
                "behavior": "effect_fallback"
              }
            ]
          }
        ]
      },
      {
        "name": "accepted"
      },
      {
        "name": "fallback",
        "entry": [
          {
            "behavior": "entry_fallback"
          }
        ]
      }
    ]
  },
  "behaviors": {
    "metadata_flag": [
      {
        "op": "trace",
        "value": "guard:metadata-get"
      },
      {
        "op": "event_metadata_get",
        "name": "ok"
      }
    ],
    "effect_accepted": [
      {
        "op": "trace",
        "value": "effect:accepted"
      }
    ],
    "effect_fallback": [
      {
        "op": "trace",
        "value": "effect:fallback"
      }
    ],
    "entry_fallback": [
      {
        "op": "trace",
        "value": "enter:fallback"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": {
        "name": "submit",
        "metadata": {
          "ok": false
        }
      }
    }
  ],
  "expect": {
    "state": "/EventMetadataGetFalsy/fallback",
    "trace": [
      {
        "type": "dispatch",
        "event": "submit"
      },
      {
        "type": "trace",
        "value": "guard:metadata-get"
      },
      {
        "type": "trace",
        "value": "effect:fallback"
      },
      {
        "type": "trace",
        "value": "enter:fallback"
      },
      {
        "type": "stable",
        "state": "/EventMetadataGetFalsy/fallback"
      }
    ]
  }
}
