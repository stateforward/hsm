{
  "version": "hsm-conformance-v1",
  "name": "event_metadata_equals_structured_guard",
  "description": "event_metadata_equals uses structural JSON equality for nested object and array metadata values.",
  "features": [
    "event_ownership",
    "guard",
    "selection_order"
  ],
  "model": {
    "name": "EventMetadataEqualsStructuredGuard",
    "initial": "idle",
    "states": [
      {
        "name": "idle",
        "transitions": [
          {
            "on": "submit",
            "guard": {
              "behavior": "metadata_matches"
            },
            "target": "accepted",
            "effects": [
              {
                "behavior": "effect_accept"
              }
            ]
          },
          {
            "on": "submit",
            "target": "fallback",
            "effects": [
              {
                "behavior": "effect_fallback"
              }
            ]
          }
        ]
      },
      {
        "name": "accepted",
        "entry": [
          {
            "behavior": "entry_accepted"
          }
        ]
      },
      {
        "name": "fallback",
        "entry": [
          {
            "behavior": "entry_fallback"
          }
        ]
      }
    ]
  },
  "behaviors": {
    "metadata_matches": [
      {
        "op": "trace",
        "value": "guard:metadata-structured"
      },
      {
        "op": "event_metadata_equals",
        "name": "context",
        "value": {
          "tenant": "acme",
          "roles": [
            "admin",
            {
              "scope": "write"
            }
          ]
        }
      }
    ],
    "effect_accept": [
      {
        "op": "trace",
        "value": "effect:accept"
      }
    ],
    "entry_accepted": [
      {
        "op": "trace",
        "value": "entry:accepted"
      }
    ],
    "effect_fallback": [
      {
        "op": "trace",
        "value": "effect:fallback"
      }
    ],
    "entry_fallback": [
      {
        "op": "trace",
        "value": "entry:fallback"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "dispatch",
      "event": {
        "name": "submit",
        "metadata": {
          "context": {
            "tenant": "acme",
            "roles": [
              "admin",
              {
                "scope": "write"
              }
            ]
          }
        }
      }
    }
  ],
  "expect": {
    "state": "/EventMetadataEqualsStructuredGuard/accepted",
    "trace": [
      {
        "type": "dispatch",
        "event": "submit"
      },
      {
        "type": "trace",
        "value": "guard:metadata-structured"
      },
      {
        "type": "trace",
        "value": "effect:accept"
      },
      {
        "type": "trace",
        "value": "entry:accepted"
      },
      {
        "type": "stable",
        "state": "/EventMetadataEqualsStructuredGuard/accepted"
      }
    ]
  }
}
