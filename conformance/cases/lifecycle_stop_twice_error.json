{
  "version": "hsm-conformance-v1",
  "name": "lifecycle_stop_twice_error",
  "description": "Stopping an instance twice leaves it stopped.",
  "features": ["lifecycle", "stop", "error"],
  "model": {
    "name": "LifecycleStopTwiceError",
    "initial": "idle",
    "states": [
      {
        "name": "idle"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    },
    {
      "op": "stop"
    },
    {
      "op": "stop"
    }
  ],
  "expect": {
    "state": "/LifecycleStopTwiceError",
    "trace": [
      {
        "type": "stable",
        "state": "/LifecycleStopTwiceError"
      }
    ]
  }
}
