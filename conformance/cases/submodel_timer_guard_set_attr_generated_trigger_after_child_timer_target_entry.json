    ],
    "entry_flag": [
      {
        "op": "trace",
        "value": "entry:flag"
      }
    ],
    "effect_ready": [
      {
        "op": "trace",
        "value": "effect:ready"
      }
    ],
    "entry_all": [
      {
        "op": "trace",
        "value": "entry:all"
      }
    ],
    "effect_wrong": [
      {
        "op": "trace",
        "value": "effect:wrong"
      }
