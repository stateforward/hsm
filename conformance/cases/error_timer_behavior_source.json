{
  "version": "hsm-conformance-v1",
  "name": "error_timer_behavior_source",
  "description": "A timer source behavior error produces a normalized runtime error before scheduling the timer.",
  "features": ["timer", "after", "timer_behavior", "error"],
  "model": {
    "name": "ErrorTimerBehaviorSource",
    "initial": "waiting",
    "states": [
      {
        "name": "waiting",
        "transitions": [
          {
            "trigger": {
              "kind": "after",
              "behavior": "timer_raises"
            },
            "target": "fired"
          }
        ]
      },
      {
        "name": "fired"
      }
    ]
  },
  "behaviors": {
    "timer_raises": [
      {
        "op": "trace",
        "value": "timer:raise"
      },
      {
        "op": "raise",
        "code": "timer_error",
        "value": "timer boom"
      }
    ]
  },
  "script": [
    {
      "op": "start"
    }
  ],
  "expect": {
    "state": "/ErrorTimerBehaviorSource/waiting",
    "error": {
      "code": "timer_error",
      "message_contains": "timer boom"
    },
    "trace": [
      {
        "type": "trace",
        "value": "timer:raise"
      },
      {
        "type": "error",
        "code": "timer_error"
      },
      {
        "type": "stable",
        "state": "/ErrorTimerBehaviorSource/waiting"
      }
    ]
  }
}
