{
  "version": "hsm-conformance-v1",
  "name": "behavior_dispatch_event_object_broadcast_metadata_isolation",
  "description": "A behavior-created event object broadcast shares ordinary mutable metadata across recipients while preserving the immutable event envelope.",
  "features": [
    "event_ownership",
    "broadcast",
    "queue",
    "reentrancy"
  ],
  "model": {
    "name": "BehaviorDispatchEventObjectBroadcastMetadataIsolation",
    "initial": "listening",
    "states": [
      {
        "name": "listening",
        "transitions": [
          {
            "on": "go",
            "effects": [
              {
                "behavior": "dispatch_audit"
              }
            ]
          },
          {
            "on": "audit",
            "guard": {
              "behavior": "owner_is_behavior"
            },
            "target": "done",
            "effects": [
              {
                "behavior": "mutate_metadata"
              }
            ]
          },
          {
            "on": "audit",
            "target": "leaked",
            "effects": [
              {
                "behavior": "effect_leaked"
              }
            ]
          }
        ]
      },
      {
        "name": "done"
      },
      {
        "name": "leaked"
      }
    ]
  },
  "instances": [
    {
      "id": "producer"
    },
    {
      "id": "peer"
    }
  ],
  "behaviors": {
    "dispatch_audit": [
      {
        "op": "dispatch",
        "target": "all",
        "event": {
          "name": "audit",
          "metadata": {
            "owner": "behavior"
          }
        }
      }
    ],
    "owner_is_behavior": [
      {
        "op": "trace",
        "value": "guard:owner-behavior"
      },
      {
        "op": "event_metadata_equals",
        "name": "owner",
        "value": "behavior"
      }
    ],
    "mutate_metadata": [
      {
        "op": "event_metadata_set",
        "name": "owner",
        "value": "changed"
      },
      {
        "op": "trace",
        "value": "effect:isolated"
      }
    ],
    "effect_leaked": [
      {
        "op": "trace",
        "value": "effect:leaked"
      }
    ]
  },
  "script": [
    {
      "op": "start",
      "instance": "producer"
    },
    {
      "op": "start",
      "instance": "peer"
    },
    {
      "op": "dispatch_to",
      "target": "producer",
      "event": "go"
    }
  ],
  "expect": {
    "states": {
      "producer": "/BehaviorDispatchEventObjectBroadcastMetadataIsolation/leaked",
      "peer": "/BehaviorDispatchEventObjectBroadcastMetadataIsolation/done"
    },
    "trace": [
      {
        "type": "dispatch",
        "event": "go",
        "target": "producer"
      },
      {
        "type": "dispatch",
        "event": "audit",
        "target": "all"
      },
      {
        "type": "trace",
        "value": "guard:owner-behavior"
      },
      {
        "type": "trace",
        "value": "effect:isolated"
      },
      {
        "type": "trace",
        "value": "guard:owner-behavior"
      },
      {
        "type": "trace",
        "value": "effect:leaked"
      },
      {
        "type": "stable",
        "state": "producer"
      }
    ]
  }
}
