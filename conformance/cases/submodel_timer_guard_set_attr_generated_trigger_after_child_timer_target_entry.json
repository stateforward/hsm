      {
        "type": "stable",
        "state": "/SubmodelTimerGuardSetAttrGeneratedTriggerAfterChildTimerTargetEntry/drive/ChildSubmodelTimerGuardSetAttrGeneratedTriggerAfterChildTimerTargetEntry/parent/all_seen"
