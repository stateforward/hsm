{
  "version": "hsm-conformance-v1",
  "name": "config_queue_len_error_event",
  "description": "A custom queue Len failure is converted to a runtime ErrorEvent that bypasses the custom queue hook.",
  "features": ["queue", "snapshot", "error"],
  "model": {
    "name": "ConfigQueueLenErrorEvent",
