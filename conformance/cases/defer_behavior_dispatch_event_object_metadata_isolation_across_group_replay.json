{
  "version": "hsm-conformance-v1",
  "name": "defer_behavior_dispatch_event_object_metadata_isolation_across_group_replay",
  "description": "A deferred behavior-created group event shares ordinary mutable metadata across replaying recipients while preserving the immutable event envelope.",
  "features": [
    "defer",
    "event_ownership",
    "group",
    "queue",
    "reentrancy"
  ],
  "model": {
    "name": "DeferBehaviorDispatchEventObjectMetadataIsolationAcrossGroupReplay",
    "initial": "hold",
    "states": [
      {
        "name": "hold",
        "defer": [
          "audit"
        ],
        "transitions": [
          {
            "on": "go",
            "effects": [
              {
                "behavior": "dispatch_audit"
              }
            ]
          },
          {
            "on": "release",
            "target": "ready"
          }
        ]
      },
      {
        "name": "ready",
        "transitions": [
          {
            "on": "audit",
            "guard": {
              "behavior": "owner_is_behavior"
            },
            "target": "done",
            "effects": [
              {
                "behavior": "mutate_metadata"
              }
            ]
          },
          {
            "on": "audit",
            "target": "leaked",
            "effects": [
              {
                "behavior": "effect_leaked"
              }
            ]
          }
        ]
      },
      {
        "name": "done"
      },
      {
        "name": "leaked"
      }
    ]
  },
  "instances": [
    {
      "id": "producer"
    },
    {
      "id": "peer"
    }
  ],
  "groups": [
    {
      "id": "both",
      "members": [
        "producer",
        "peer"
      ]
    }
  ],
  "behaviors": {
    "dispatch_audit": [
      {
        "op": "dispatch",
        "group": "both",
        "event": {
          "name": "audit",
          "metadata": {
            "owner": "behavior"
          }
        }
      }
    ],
    "owner_is_behavior": [
      {
        "op": "trace",
        "value": "guard:owner-behavior"
      },
      {
        "op": "event_metadata_equals",
        "name": "owner",
        "value": "behavior"
      }
    ],
    "mutate_metadata": [
      {
        "op": "event_metadata_set",
        "name": "owner",
        "value": "changed"
      },
      {
        "op": "trace",
        "value": "effect:isolated"
      }
    ],
    "effect_leaked": [
      {
        "op": "trace",
        "value": "effect:leaked"
      }
    ]
  },
  "script": [
    {
      "op": "start",
      "instance": "producer"
    },
    {
      "op": "start",
      "instance": "peer"
    },
    {
      "op": "dispatch_to",
      "target": "producer",
      "event": "go"
    },
    {
      "op": "dispatch_to",
      "targets": [
        "producer",
        "peer"
      ],
      "event": "release"
    }
  ],
  "expect": {
    "states": {
      "producer": "/DeferBehaviorDispatchEventObjectMetadataIsolationAcrossGroupReplay/done",
      "peer": "/DeferBehaviorDispatchEventObjectMetadataIsolationAcrossGroupReplay/leaked"
    },
    "trace": [
      {
        "type": "dispatch",
        "event": "go",
        "target": "producer"
      },
      {
        "type": "dispatch",
        "event": "audit",
        "target": "both"
      },
      {
        "type": "defer",
        "event": "audit"
      },
      {
        "type": "defer",
        "event": "audit"
      },
      {
        "type": "dispatch",
        "event": "release",
        "target": [
          "producer",
          "peer"
        ]
      },
      {
        "type": "undefer",
        "event": "audit"
      },
      {
        "type": "trace",
        "value": "guard:owner-behavior"
      },
      {
        "type": "trace",
        "value": "effect:isolated"
      },
      {
        "type": "undefer",
        "event": "audit"
      },
      {
        "type": "trace",
        "value": "guard:owner-behavior"
      },
      {
        "type": "trace",
        "value": "effect:leaked"
      },
      {
        "type": "stable",
        "state": "targets:producer,peer"
      }
    ]
  }
}
