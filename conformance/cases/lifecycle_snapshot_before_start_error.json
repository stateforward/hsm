{
  "version": "hsm-conformance-v1",
  "name": "lifecycle_snapshot_before_start_error",
  "description": "Taking a snapshot before start produces a normalized lifecycle error.",
  "features": ["lifecycle", "snapshot", "error"],
  "model": {
    "name": "LifecycleSnapshotBeforeStartError",
    "initial": "idle",
    "states": [
      {
        "name": "idle"
      }
    ]
  },
  "script": [
    {
      "op": "snapshot"
    }
  ],
  "expect": {
    "state": "",
    "error": {
      "code": "runtime_error",
      "message_contains": "started"
    },
    "trace": [
      {
        "type": "error",
        "code": "runtime_error"
      },
      {
        "type": "stable",
        "state": ""
      }
    ]
  }
}
