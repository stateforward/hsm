{
  "version": "hsm-conformance-v1",
  "name": "invalid_at_timer_missing_attribute",
  "mode": "validation",
  "description": "An at timer trigger using an attribute source must reference a declared model attribute.",
  "features": ["timer", "at", "validation"],
  "model": {
    "name": "InvalidAtTimerMissingAttribute",
    "initial": "waiting",
    "states": [
      {
        "name": "waiting",
        "transitions": [
          {
            "trigger": {
              "kind": "at",
              "attribute": "missing_deadline"
            },
            "target": "done"
          }
        ]
      },
      {
        "name": "done"
      }
    ]
  },
  "expect": {
    "validation": [
      {
        "code": "missing_timer_attribute"
      }
    ]
  }
}
