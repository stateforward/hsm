{
  "version": "hsm-conformance-v1",
  "name": "invalid_submodel_when_missing_behavior",
  "mode": "validation",
  "description": "when behavior references inside child models must be validated recursively.",
  "features": ["submachine", "when", "validation"],
  "model": {
    "name": "InvalidSubmodelWhenMissingBehavior",
    "initial": "drive",
    "states": [
      {
        "name": "drive",
        "kind": "submachine",
        "machine": "ChildWithMissingWhenBehavior"
      }
    ]
  },
  "models": [
    {
      "name": "ChildWithMissingWhenBehavior",
      "initial": "idle",
      "states": [
        {
          "name": "idle",
          "transitions": [
            {
              "trigger": {
                "kind": "when",
                "behavior": "missing_child_when"
              },
              "target": "done"
            }
          ]
        },
        {
          "name": "done"
        }
      ]
    }
  ],
  "expect": {
    "validation": [
      {
        "code": "missing_behavior"
      }
    ]
  }
}
