{
  "version": "hsm-conformance-v1",
  "name": "invalid_timer_extraneous_events",
  "mode": "validation",
  "description": "A timer trigger must not declare plural events operands from on triggers.",
  "features": ["timer", "after", "validation"],
  "model": {
    "name": "InvalidTimerExtraneousEvents",
    "initial": "waiting",
    "states": [
      {
        "name": "waiting",
        "transitions": [
          {
            "trigger": {
              "kind": "after",
              "duration_ms": 10,
              "events": ["go"]
            },
            "target": "done"
          }
        ]
      },
      {
        "name": "done"
      }
    ]
  },
  "expect": {
    "validation": [
      {
        "code": "extraneous_trigger_operand"
      }
    ]
  }
}
